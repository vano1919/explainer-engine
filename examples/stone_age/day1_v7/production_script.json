   "id": "S01",
   "beat": "hook",
   "light_beat": 1,
   "lines": [
    {
     "text": "Could the greatest minds in history survive the Stone Age?",
     "tags": [
      "softly",
      "intrigued"
     ],
     "emphasis": [
      "age"
     ],
     "tone": "hushed question",
     "emotion": "intrigue"
    },
    {
     "text": "No tools."
    },
    {
     "text": "No matches."
    },
    {
     "text": "And night is coming fast.",
     "tags": [
      "slowly"
     ],
     "emotion": "unease",
