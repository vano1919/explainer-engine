  {
   "id": "S03",
   "beat": "meadow",
   "light_beat": 3,
   "lines": [
    {
     "text": "Day one, late morning.",
     "tags": [
      "warmly"
     ],
     "emotion": "gentle irony"
    },
    {
     "text": "A hundred brilliant people."
    },
    {
     "text": "A hundred different ideas of what to do first."
    },
    {
     "text": "For a whole hour, nothing useful happens."
    },
    {
     "text": "Then Fridtjof Nansen, the man who crossed Greenland on skis, asks the one question that matters."
    },
    {
     "text": "Can anyone here make fire without matches?",
     "emphasis": [
      "matches"
     ],
     "emotion": "quiet urgency"
    },
    {
     "text": "Two hands go up.",
     "tags": [
      "short pause"
     ],
     "emotion": "wry"
    },
    {
     "text": "Halfway."
    },
    {
     "text": "Two!",
     "tags": [
      "chuckles"
     ],
     "emotion": "dry humour"
    },
    {
     "text": "Out of a hundred."
    },
    {
     "text": "And both of them look unsure."
    }
   ],
   "shots": [
    {
     "at": "Day one,",
     "type": "A",
     "motion": {
      "kind": "pull",
      "z0": 1.08,
      "z1": 1.0
     },
     "picture": "v5_d1-10"
    },
