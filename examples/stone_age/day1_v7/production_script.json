  {
   "id": "S02",
   "beat": "rules",
   "light_beat": 2,
   "lines": [
    {
     "text": "Right.",
     "tags": [
      "warmly"
     ],
     "tone": "storyteller settling in",
     "emotion": "calm amusement"
    },
    {
     "text": "Here are the rules."
    },
    {
     "text": "A hundred scientists."
    },
    {
     "text": "A river valley in southeastern Anatolia, twelve thousand years ago."
    },
    {
     "text": "Each one arrives at the age of their most famous work."
    },
    {
     "text": "Same clothes."
    },
    {
     "text": "Only what's in their pockets."
    },
    {
     "text": "They can all understand each other, and that's the only magic.",
     "emphasis": [
      "only"
     ],
     "emotion": "dry wit"
    },
    {
     "text": "The rocks, the plants, the physics: all painfully real."
    },
    {
     "text": "The scientists are real people.",
     "tags": [
      "thoughtful"
     ],
     "emotion": "sincere"
    },
    {
     "text": "What they say and do here is our invention."
    },
    {
     "text": "So who takes charge?",
     "tags": [
      "amused"
     ],
     "emotion": "curiosity",
     "pause_after": 0.5
    },
    {
     "text": "And who panics first?"
    }
   ],
   "shots": [
    {
     "at": "Right.",
     "type": "A",
     "motion": {
      "kind": "pan",
      "z0": 1.06,
      "z1": 1.06,
