  {
   "id": "S04",
   "beat": "meadow",
   "light_beat": 3,
   "lines": [
    {
     "text": "Hmm.",
     "tags": [
      "thoughtful"
     ],
     "emotion": "musing"
    },
    {
     "text": "Somebody has to take over."
    },
    {
     "text": "Benjamin Franklin does, naturally."
    },
    {
     "text": "One rule: every group reports at a nightly meeting, and anyone can stop work for safety."
    },
    {
     "text": "Even Newton agrees."
    },
    {
     "text": "Somebody write that down.",
     "tags": [
      "amused"
     ],
     "emotion": "dry humour"
    },
    {
     "text": "But a rule won't keep anyone warm.",
     "tags": [
      "softly"
     ],
     "emotion": "concern"
    },
    {
     "text": "And the sun is already sinking."
    }
   ],
   "shots": [
    {
     "at": "Hmm.",
     "type": "B",
     "motion": {
      "kind": "push",
      "z0": 1.0,
