    "provider": "gemini_native_image_engine",
    "tool": "image_gen:generate_image",
    "reference_library_dir": "Explainer_Engine_V4_Main/Reference_Library",
    "style_anchor_token": "Luminescent Chiaroscuro and Tactile Mythic Realism historical docudrama",
    "aspect_ratio": "16:9",
    "unique_scene_per_shot_enforced": true
