      },
      "comfyui_controlnet_aux": {
        "repo_url": "https://github.com/Fannovel16/comfyui_controlnet_aux",
        "pinned_ref": "main",
        "nodes": [
          "DWPreprocessor",
          "CannyEdgePreprocessor",
          "DepthAnythingV2Preprocessor"
        ]
      }
    }
  },
