diff --git a/explainer_engine/edit/clay_video.py b/explainer_engine/edit/clay_video.py
new file mode 100644
index 0000000..81fc256
--- /dev/null
+++ b/explainer_engine/edit/clay_video.py
@@ -0,0 +1,256 @@
+"""Clay layout clips for LTX-2.5's Layout-To-Render IC-LoRA (P12 stage L2, WP-1c; reusable, OR-21).
+
+The LoRA's model card (Lightricks/LTX-2.5-22b-IC-LoRA-Layout-To-Render @ bd765d55, "Control Signal Requirements"): the driving
+clip is "a grey clay viewport, or a blocky playblast of simple shapes" carrying the camera move and where objects sit; 24 fps
+preferred; width and height divisible by 64 (1920x1088 known good); the frame count is snapped to 8k+1; the art direction comes
+from a keyframe made from the clay's FIRST frame, so the clay's first frame must put every block where the keyframe has its
+figure. Nothing here assumes more than that card says: flat-lit grey blocks, a grey floor and back wall, a pinhole camera.
+
+A spec (JSON, one per shot)::
+
+    {"id": "tent_s0", "seconds": 5.0417, "fps": 24, "width": 1920, "height": 1088,
+     "camera": [{"t": 0, "pos": [0, 1.6, -6], "look": [0, 1.2, 0], "fov": 50}, {"t": 5, "pos": [0, 1.6, -4.5], ...}],
+     "room": {"floor_y": 0, "back_z": 4, "half_width": 8, "height": 4},
+     "objects": [{"id": "emperor", "shape": "figure", "size": [0.6, 1.75, 0.4],
+                  "keys": [{"t": 0, "pos": [-1.2, 0, 0], "yaw": 20}, {"t": 3, "pos": [-0.8, 0, 0.3], "yaw": 0}]},
+                 {"id": "table", "shape": "box", "size": [1.8, 0.8, 1.0], "keys": [{"t": 0, "pos": [0, 0, 0.5]}]}]}
+
+``t`` is in seconds; positions are metres (x right, y up, z away from the camera's start); a key's missing fields hold the
+previous key's value; between keys the value eases (smoothstep). Shapes: ``box``, ``cylinder`` (12-sided prism) and ``figure``
+(a blocky person: legs, body, head; its ``size`` is width, height, depth). Rendering is a pure function of (spec, frame).
+
+    python -m explainer_engine.edit.clay_video render <spec.json> <out.mp4> [--width W --height H --frames N]
+    python -m explainer_engine.edit.clay_video first <spec.json> <out.png>      # the frame the keyframe must match
+
+A file with ``{"shots": {id: spec, ...}}`` (the P12 specs, ``training/pods/p12/clay/clay_specs.json``) is named
+``<file.json>#<id>``.
+"""
+from __future__ import annotations
+
+import json
+import math
+import subprocess
+import sys
+from pathlib import Path
+
+import numpy as np
+from PIL import Image, ImageDraw
+
+GRID = 8                     # LTX: frames = 8k + 1 (model card, "Preprocessing")
+SIZE_STEP = 64               # width and height divide by 64 (model card)
+LIGHT = np.array([-0.4, 0.8, -0.45])
+LIGHT = LIGHT / np.linalg.norm(LIGHT)
+GREYS = {"floor": 150, "wall": 175, "object": 205}
+SKY = (120, 120, 120)
+
+
+def snap_frames(n: int) -> int:
+    """The largest 8k+1 not above ``n`` (the LoRA trims to it; we render exactly that count)."""
+    if n < 1:
+        raise ValueError("a clip needs at least one frame")
+    return (n - 1) // GRID * GRID + 1
+
+
+def frame_count(spec: dict) -> int:
+    return snap_frames(int(round(float(spec["seconds"]) * int(spec.get("fps", 24)))) + 1)
+
+
+def check_spec(spec: dict) -> list[str]:
+    """Problems that make a spec unusable for the LoRA (empty = fine)."""
+    out = []
+    w, h = int(spec.get("width", 1920)), int(spec.get("height", 1088))
+    if w % SIZE_STEP or h % SIZE_STEP:
+        out.append(f"{w}x{h}: width and height must divide by {SIZE_STEP} (model card)")
+    if not spec.get("camera"):
+        out.append("no camera keys")
+    for o in spec.get("objects", []):
+        if o.get("shape") not in ("box", "cylinder", "figure"):
+            out.append(f"{o.get('id')}: shape {o.get('shape')!r} is not box, cylinder or figure")
+        if not o.get("keys"):
+            out.append(f"{o.get('id')}: no keys")
+    return out
+
+
+def _ease(x: float) -> float:
+    x = min(1.0, max(0.0, x))
+    return x * x * (3 - 2 * x)
+
+
+def _at(keys: list[dict], t: float, field: str, default):
+    """The eased value of ``field`` at time ``t`` over keys sorted by t (a missing field holds the previous value)."""
+    filled, last = [], default
+    for k in sorted(keys, key=lambda k: float(k.get("t", 0))):
+        last = k.get(field, last)
+        filled.append((float(k.get("t", 0)), last))
+    if not filled:
+        return default
+    if t <= filled[0][0]:
+        return filled[0][1]
+    for (t0, v0), (t1, v1) in zip(filled, filled[1:]):
+        if t0 <= t <= t1:
+            a = _ease((t - t0) / (t1 - t0)) if t1 > t0 else 1.0
+            if isinstance(v0, (list, tuple)):
+                return [x0 + (x1 - x0) * a for x0, x1 in zip(v0, v1)]
+            return v0 + (v1 - v0) * a
+    return filled[-1][1]
+
+
+def _box(cx: float, y0: float, cz: float, w: float, h: float, d: float, yaw: float) -> list[np.ndarray]:
+    """Six quads of a box standing on y0, centred on (cx, cz), turned by yaw degrees about y."""
+    c, s = math.cos(math.radians(yaw)), math.sin(math.radians(yaw))
+    pts = []
+    for dy in (0, h):
+        for dx, dz in ((-w / 2, -d / 2), (w / 2, -d / 2), (w / 2, d / 2), (-w / 2, d / 2)):
+            pts.append((cx + dx * c + dz * s, y0 + dy, cz - dx * s + dz * c))
+    p = np.array(pts)
+    idx = [(0, 1, 2, 3), (4, 7, 6, 5), (0, 4, 5, 1), (1, 5, 6, 2), (2, 6, 7, 3), (3, 7, 4, 0)]
+    return [p[list(f)] for f in idx]
+
+
+def _cylinder(cx: float, y0: float, cz: float, w: float, h: float, d: float, sides: int = 12) -> list[np.ndarray]:
+    ring = [(cx + w / 2 * math.cos(2 * math.pi * i / sides), cz + d / 2 * math.sin(2 * math.pi * i / sides)) for i in range(sides)]
+    faces = [np.array([(x, y0 + h, z) for x, z in ring])]
+    for (x0, z0), (x1, z1) in zip(ring, ring[1:] + ring[:1]):
+        faces.append(np.array([(x0, y0, z0), (x1, y0, z1), (x1, y0 + h, z1), (x0, y0 + h, z0)]))
+    return faces
+
+
+def _figure(cx: float, y0: float, cz: float, w: float, h: float, d: float, yaw: float) -> list[np.ndarray]:
+    """A blocky person: legs 45 %, body 37 %, head 18 % of the height (a playblast stand-in, not a likeness)."""
+    legs, body, head = 0.45 * h, 0.37 * h, 0.18 * h
+    return (_box(cx, y0, cz, 0.7 * w, legs, 0.7 * d, yaw) + _box(cx, y0 + legs, cz, w, body, d, yaw)
+            + _box(cx, y0 + legs + body, cz, 0.45 * w, head, 0.55 * d, yaw))
+
+
+def _faces(spec: dict, t: float) -> list[tuple[np.ndarray, int]]:
+    room = {"floor_y": 0.0, "back_z": 6.0, "half_width": 10.0, "height": 5.0, "near_z": -20.0, **spec.get("room", {})}
+    fy, bz, hw, rh, nz = (float(room[k]) for k in ("floor_y", "back_z", "half_width", "height", "near_z"))
+    out = [(np.array([(-hw, fy, nz), (hw, fy, nz), (hw, fy, bz), (-hw, fy, bz)]), GREYS["floor"]),
+           (np.array([(-hw, fy, bz), (hw, fy, bz), (hw, fy + rh, bz), (-hw, fy + rh, bz)]), GREYS["wall"])]
+    for o in spec.get("objects", []):
+        x, y, z = _at(o["keys"], t, "pos", [0.0, fy, 0.0])
+        yaw = float(_at(o["keys"], t, "yaw", 0.0))
+        w, h, d = (float(v) for v in o.get("size", [1, 1, 1]))
+        grey = int(o.get("grey", GREYS["object"]))
+        if o["shape"] == "box":
+            fs = _box(x, y, z, w, h, d, yaw)
+        elif o["shape"] == "cylinder":
+            fs = _cylinder(x, y, z, w, h, d)
+        else:
+            fs = _figure(x, y, z, w, h, d, yaw)
+        out += [(f, grey) for f in fs]
+    return out
+
+
+def _camera(spec: dict, t: float) -> tuple[np.ndarray, np.ndarray, float]:
+    keys = spec["camera"]
+    pos = np.array(_at(keys, t, "pos", [0.0, 1.6, -6.0]), dtype=float)
+    look = np.array(_at(keys, t, "look", [0.0, 1.2, 0.0]), dtype=float)
+    fov = float(_at(keys, t, "fov", 50.0))
+    fwd = look - pos
+    fwd /= np.linalg.norm(fwd)
+    right = np.cross(np.array([0.0, 1.0, 0.0]), fwd)
+    right /= np.linalg.norm(right)
+    up = np.cross(fwd, right)
+    return pos, np.stack([right, up, fwd]), fov
+
+
+def render_frame(spec: dict, i: int, width: int | None = None, height: int | None = None) -> Image.Image:
+    """Frame ``i`` of the clip: painter's algorithm over flat-shaded quads, faces behind the camera clipped away."""
+    w, h = int(width or spec.get("width", 1920)), int(height or spec.get("height", 1088))
+    t = i / float(spec.get("fps", 24))
+    pos, rot, fov = _camera(spec, t)
+    f = (w / 2) / math.tan(math.radians(fov) / 2)
+    img = Image.new("RGB", (w, h), SKY)
+    dr = ImageDraw.Draw(img)
+    drawn = []
+    for k, (quad, grey) in enumerate(_faces(spec, t)):
+        cam = (quad - pos) @ rot.T
+        if (cam[:, 2] <= 0.05).any():
+            cam = _clip_near(cam)
+            if cam is None:
+                continue
+        n = np.cross(quad[1] - quad[0], quad[2] - quad[0])
+        nn = np.linalg.norm(n)
+        if nn == 0:
+            continue
+        n /= nn
+        centre = quad.mean(axis=0)
+        if np.dot(n, centre - pos) > 0:          # face turned away: flip (rooms are seen from inside, blocks from outside)
+            n = -n
+        shade = grey * (0.45 + 0.55 * max(0.0, float(np.dot(n, LIGHT))))
+        pts = [(w / 2 + f * x / z, h / 2 - f * y / z) for x, y, z in cam]
+        # the floor and back wall (the first two faces) always go first: their centroids lie close to the camera
+        depth = math.inf if k < 2 else float(np.linalg.norm(centre - pos))
+        drawn.append((depth, pts, int(min(255, shade))))
+    for _, pts, g in sorted(drawn, key=lambda d: -d[0]):
+        dr.polygon(pts, fill=(g, g, g), outline=(max(0, g - 40),) * 3)
+    return img
+
+
+def _clip_near(cam: np.ndarray, near: float = 0.05):
+    """Sutherland-Hodgman against z = near; None when nothing is in front."""
+    out = []
+    for a, b in zip(cam, np.roll(cam, -1, axis=0)):
+        ina, inb = a[2] > near, b[2] > near
+        if ina:
+            out.append(a)
+        if ina != inb:
+            k = (near - a[2]) / (b[2] - a[2])
+            out.append(a + (b - a) * k)
+    return np.array(out) if len(out) >= 3 else None
+
+
+def render(spec: dict, out: Path, *, width: int | None = None, height: int | None = None, frames: int | None = None) -> dict:
+    """The clip as H.264 mp4 (yuv420p, the spec's fps), exactly 8k+1 frames; returns its facts."""
+    w, h = int(width or spec.get("width", 1920)), int(height or spec.get("height", 1088))
+    problems = check_spec({**spec, "width": w, "height": h})          # the override is checked too, not only the spec's own size
+    if problems:
+        raise ValueError("; ".join(problems))
+    n = snap_frames(frames) if frames else frame_count(spec)
+    fps = int(spec.get("fps", 24))
+    out.parent.mkdir(parents=True, exist_ok=True)
+    tmp = out.with_suffix(".part.mp4")
+    ff = subprocess.Popen(["ffmpeg", "-v", "error", "-y", "-f", "rawvideo", "-pix_fmt", "rgb24", "-s", f"{w}x{h}", "-r", str(fps),
+                           "-i", "-", "-frames:v", str(n), "-c:v", "libx264", "-pix_fmt", "yuv420p", "-crf", "16",
+                           "-threads", "1", "-fflags", "+bitexact", "-flags:v", "+bitexact", "-map_metadata", "-1", str(tmp)],
+                          stdin=subprocess.PIPE)
+    try:
+        for i in range(n):
+            ff.stdin.write(render_frame(spec, i, w, h).tobytes())
+    finally:
+        ff.stdin.close()
+        rc = ff.wait()
+    if rc:
+        raise RuntimeError(f"ffmpeg exited {rc}")
+    tmp.replace(out)
+    return {"id": spec.get("id"), "path": str(out), "frames": n, "fps": fps, "width": w, "height": h}
+
+
+def load_spec(ref: str) -> dict:
+    """``spec.json`` or ``shots.json#<id>``."""
+    path, _, shot = ref.partition("#")
+    doc = json.loads(Path(path).read_text(encoding="utf-8"))
+    if "shots" in doc:
+        if shot not in doc["shots"]:
+            raise SystemExit(f"{path}: name a shot with #<id>, one of {sorted(doc['shots'])}")
+        return doc["shots"][shot]
+    return doc
+
+
+def main(argv: list[str]) -> int:
+    if len(argv) < 3 or argv[0] not in ("render", "first"):
+        print(__doc__)
+        return 2
+    spec = load_spec(argv[1])
+    opts = {argv[i].lstrip("-"): int(argv[i + 1]) for i in range(3, len(argv) - 1, 2)}
+    if argv[0] == "first":
+        render_frame(spec, 0, opts.get("width"), opts.get("height")).save(argv[2])
+        print(argv[2])
+        return 0
+    print(json.dumps(render(spec, Path(argv[2]), **opts)))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
diff --git a/explainer_engine/edit/dramatic_still.py b/explainer_engine/edit/dramatic_still.py
new file mode 100644
index 0000000..d37b1e2
--- /dev/null
+++ b/explainer_engine/edit/dramatic_still.py
@@ -0,0 +1,130 @@
+"""A held still must change dramatically (BP-170, the creator 2026-11-01: a still may stay up to 5 s only if something dramatic
+changes in it, a person cut out and placed elsewhere; a small dot or a small hammer is not enough).
+
+The simple version, on purpose: a validator for the spec of the change, a pixel measure of two frames, and a renderer that cuts a
+subject out of a clean plate and puts it elsewhere (or swaps the plate). No other module is touched: slow zooms (parallax),
+text pops and accents are minor events and never count (C8.2), so they do not appear here at all.
+
+    validate_dramatic_change(spec, shot_seconds=4.0, zone_id="middle_calm_90_480s") -> findings (empty = fine)
+    check_script_stills(shots)                                                    -> findings for every still shot of a script
+    measure_frame_change(before, after)                                           -> {"changed_frac", "is_dramatic", ...}
+    render_dramatic_still(bg_before, subject_rgba, spec, t_s=..., bg_after=None) -> the frame at second t_s
+
+A spec is the object of ``schemas/dramatic_still.schema.json``. The declared numbers are not trusted: the relocation and the
+subject area are computed from the boxes.
+"""
+
+from __future__ import annotations
+
+import math
+
+from explainer_engine.edit import rhythm_profile
+from explainer_engine.standards import sourced_rules as SR
+
+
+def _finding(severity: str, where: str, detail: str) -> dict:
+    return {"rule": "BP-170", "severity": SR.level("BP-170", severity), "where": where, "detail": detail}
+
+
+def _center(box):
+    return ((box[0] + box[2]) / 2.0, (box[1] + box[3]) / 2.0)
+
+
+def box_area(box) -> float:
+    return max(0.0, box[2] - box[0]) * max(0.0, box[3] - box[1])
+
+
+def relocation(from_box, to_box) -> float:
+    """Distance between the box centres in frame fractions (x and y both 0..1, so the diagonal is ~1.41)."""
+    (ax, ay), (bx, by) = _center(from_box), _center(to_box)
+    return math.hypot(bx - ax, by - ay)
+
+
+def validate_dramatic_change(spec: dict | None, *, shot_seconds: float, zone_id: str = "middle_calm_90_480s",
+                             where: str = "still") -> list[dict]:
+    """Findings for one held still. A still shorter than its zone's static hold needs no change; longer than BP-109's cap it
+    fails whatever it does; in between it needs a change that is large, in the middle of the hold."""
+    cap = SR.T("BP-109", "still_shot_max_s")
+    static = SR.T("BP-170", "static_still_max_s_by_zone")
+    if zone_id not in static:
+        raise KeyError(f"unknown zone {zone_id!r}")
+    if shot_seconds > cap:
+        return [_finding("FAIL", where, f"{shot_seconds:g} s is over the {cap:g} s cap of a still (BP-109): cut or make it video")]
+    if shot_seconds <= static[zone_id]:
+        return []
+    if not spec:
+        return [_finding("FAIL", where, f"held {shot_seconds:g} s in {zone_id} (static limit {static[zone_id]:g} s) with no "
+                                        "dramatic change: add a relocation or a plate swap, or cut it shorter")]
+    out: list[dict] = []
+    kind = spec.get("kind")
+    if kind in ("cutout_relocation", "composite_cutout_and_plate"):
+        if not (spec.get("from_box") and spec.get("to_box")):
+            out.append(_finding("FAIL", where, "a cutout relocation names its from_box and to_box"))
+        else:
+            dist = relocation(spec["from_box"], spec["to_box"])
+            area = box_area(spec["from_box"])
+            need_d, need_a = SR.T("BP-170", "min_relocation_distance_frac"), SR.T("BP-170", "min_subject_area_frac")
+            if dist < need_d:
+                out.append(_finding("FAIL", where, f"the subject moves {dist:.2f} of the frame (< {need_d}): a nudge is not a change"))
+            if area < need_a:
+                out.append(_finding("FAIL", where, f"the subject covers {area:.2f} of the frame (< {need_a}): a small thing is not a change"))
+    if kind in ("plate_swap", "composite_cutout_and_plate"):
+        need_p = SR.T("BP-170", "min_plate_swap_pixel_frac")
+        if float(spec.get("plate_swap_pixel_frac", 0.0)) < need_p:
+            out.append(_finding("FAIL", where, f"the plate changes {spec.get('plate_swap_pixel_frac', 0.0)} of the pixels (< {need_p})"))
+    if kind not in ("cutout_relocation", "plate_swap", "composite_cutout_and_plate"):
+        out.append(_finding("FAIL", where, f"unknown change kind {kind!r}"))
+    lo, hi = SR.T("BP-170", "change_window_frac")
+    at = float(spec.get("at_s", -1))
+    if not lo * shot_seconds <= at <= hi * shot_seconds:
+        out.append(_finding("FAIL", where, f"the change at {at:g} s is outside the middle of the hold "
+                                           f"({lo * shot_seconds:.2f}-{hi * shot_seconds:.2f} s): it must be seen, not at the edge"))
+    return out
+
+
+def check_script_stills(shots: list[dict], *, profile_name: str = "mrbeast_animated") -> list[dict]:
+    """Every still shot of a script (BP-109 lane ``still``): its hold against its zone. A shot's time is its ``start_s`` or the
+    running sum of ``seconds``; its change, if any, is ``dramatic_change``."""
+    from explainer_engine.scripting.film_shots import visual_lane
+    total = sum(float(s["seconds"]) for s in shots)
+    t, out = 0.0, []
+    for s in shots:
+        start = float(s.get("start_s", t))
+        t = start + float(s["seconds"])
+        if visual_lane(s) != "still":
+            continue
+        zone = rhythm_profile.zone_at_time(start, total_s=max(total, 1.0), profile_name=profile_name)["id"]
+        out += validate_dramatic_change(s.get("dramatic_change"), shot_seconds=float(s["seconds"]), zone_id=zone,
+                                        where=str(s.get("id", "?")))
+    return out
+
+
+def measure_frame_change(before, after, *, pixel_delta: int = 24) -> dict:
+    """How much of the picture differs between two frames (PIL images of one size). A relocation changes the old and the new
+    place of the subject, a plate swap most of the frame; a small dot or a 4 % shift changes little."""
+    import numpy as np
+    a = np.asarray(before.convert("RGB"), dtype=np.int16)
+    b = np.asarray(after.convert("RGB"), dtype=np.int16)
+    if a.shape != b.shape:
+        raise ValueError("frames of different sizes")
+    mask = np.abs(a - b).max(axis=2) > pixel_delta
+    frac = float(mask.mean())
+    swap = frac >= SR.T("BP-170", "min_plate_swap_pixel_frac")
+    moved = frac >= SR.T("BP-170", "min_subject_area_frac")
+    return {"changed_frac": round(frac, 4), "plate_swap": swap, "is_dramatic": bool(swap or moved)}
+
+
+def render_dramatic_still(bg_before, subject_rgba, spec: dict, *, t_s: float, bg_after=None):
+    """The frame at second ``t_s``: before ``spec['at_s']`` the subject stands in ``from_box`` on ``bg_before``; from then on in
+    ``to_box`` on ``bg_after`` (or the same plate). The plate must be clean, without the subject baked in, or the cut leaves a hole."""
+    from PIL import Image
+    after = t_s >= float(spec["at_s"])
+    plate = (bg_after if (after and bg_after is not None) else bg_before).convert("RGBA")
+    frame = plate.copy()
+    box = spec["to_box"] if after else spec["from_box"]
+    if spec.get("kind") != "plate_swap" and box:
+        w, h = frame.size
+        x0, y0, x1, y1 = round(box[0] * w), round(box[1] * h), round(box[2] * w), round(box[3] * h)
+        sub = subject_rgba.convert("RGBA").resize((max(1, x1 - x0), max(1, y1 - y0)), Image.LANCZOS)
+        frame.alpha_composite(sub, (x0, y0))
+    return frame.convert("RGB")
diff --git a/explainer_engine/edit/rhythm_profile.py b/explainer_engine/edit/rhythm_profile.py
new file mode 100644
index 0000000..6329193
--- /dev/null
+++ b/explainer_engine/edit/rhythm_profile.py
@@ -0,0 +1,115 @@
+"""The one reader of the rhythm profile (BP-169): which zone of the episode a second belongs to, and what the zone asks for.
+
+Every number lives in ``standards/sourced_rules.json`` (BP-169); nothing here copies one. ``calm_docudrama`` is the older
+profile: it has no zones, its numbers are the other BP rows (BP-01, BP-107 ...), so a script of that era keeps its checks.
+stdlib only.
+
+    available_profiles()                       -> ["mrbeast_animated", "calm_docudrama"]
+    resolve_profile_name(doc)                  -> a name from the doc's ``rhythm_profile`` or its schema version
+    zone_at_time(t_s, total_s=720.0)           -> the zone dict at second t_s (the last zone owns total_s itself)
+    zone_for_window(start_s, end_s)            -> the zone that holds most of [start_s, end_s)
+    zone_wpm(zone_id, kind="heard")            -> the pace target of a zone
+    words_to_seconds(words, t_start_s)         -> seconds the words take when read at the zones' pace, zone by zone
+"""
+
+from __future__ import annotations
+
+from explainer_engine.standards import sourced_rules as SR
+
+LEGACY = "calm_docudrama"
+
+
+def _profiles() -> dict:
+    return SR.T("BP-169", "profiles")
+
+
+def available_profiles() -> list[str]:
+    return list(_profiles())
+
+
+def resolve_profile_name(doc: dict | None = None) -> str:
+    """The profile a document asks for: its ``rhythm_profile`` key, else the version of its schema (``production_script/3``
+    is the calm era, ``/4`` and later the zoned one), else the registry default."""
+    doc = doc or {}
+    name = doc.get("rhythm_profile")
+    if name is None:
+        schema = str(doc.get("schema", ""))
+        tail = schema.rsplit("/", 1)[-1]
+        if tail.isdigit():
+            name = LEGACY if int(tail) <= 3 else SR.T("BP-169", "default_profile")
+    name = name or SR.T("BP-169", "default_profile")
+    if name not in _profiles():
+        raise KeyError(f"unknown rhythm profile {name!r}; known: {available_profiles()}")
+    return name
+
+
+def get_profile(doc_or_name: dict | str | None = None) -> dict:
+    name = doc_or_name if isinstance(doc_or_name, str) else resolve_profile_name(doc_or_name)
+    if name not in _profiles():
+        raise KeyError(f"unknown rhythm profile {name!r}; known: {available_profiles()}")
+    prof = _profiles()[name]
+    if not isinstance(prof, dict):
+        raise KeyError(f"{name!r} has no zones: it is the legacy profile, read the other BP rows")
+    return prof
+
+
+def _scaled(prof: dict, total_s: float) -> list[tuple[float, float, dict]]:
+    base = float(SR.T("BP-169", "episode_s"))
+    k = total_s / base
+    return [(z["window_s"][0] * k, z["window_s"][1] * k, z) for z in prof["zones"]]
+
+
+def zone_at_time(t_s: float, *, total_s: float = 720.0, profile_name: str = "mrbeast_animated") -> dict:
+    if t_s < 0:
+        raise ValueError("time before the start of the episode")
+    zones = _scaled(get_profile(profile_name), total_s)
+    for lo, hi, z in zones:
+        if lo <= t_s < hi:
+            return z
+    return zones[-1][2]  # the right boundary and anything after belong to the last zone
+
+
+def zone_for_window(start_s: float, end_s: float, *, total_s: float = 720.0, profile_name: str = "mrbeast_animated") -> dict:
+    if end_s <= start_s:
+        raise ValueError("an empty window")
+    best, best_len = None, -1.0
+    for lo, hi, z in _scaled(get_profile(profile_name), total_s):
+        overlap = min(end_s, hi) - max(start_s, lo)
+        if overlap > best_len:
+            best, best_len = z, overlap
+    return best
+
+
+def zone_wpm(zone_id: str | None = None, *, profile_name: str | None = None, kind: str = "heard") -> float:
+    """The pace target of a zone; with no zone, the episode's time-weighted mean."""
+    if kind not in ("heard", "speaking"):
+        raise ValueError("kind is 'heard' or 'speaking'")
+    prof = get_profile(profile_name or SR.T("BP-169", "default_profile"))
+    key = f"{kind}_wpm_target"
+    if zone_id is not None:
+        for z in prof["zones"]:
+            if z["id"] == zone_id:
+                return float(z[key])
+        raise KeyError(f"unknown zone {zone_id!r}")
+    span = sum(z["window_s"][1] - z["window_s"][0] for z in prof["zones"])
+    return sum(z[key] * (z["window_s"][1] - z["window_s"][0]) for z in prof["zones"]) / span
+
+
+def words_to_seconds(words: int, *, t_start_s: float = 0.0, total_s: float = 720.0,
+                     profile_name: str = "mrbeast_animated") -> float:
+    """Seconds that ``words`` take when read at the heard pace of the zone they fall in, starting at t_start_s (a read that
+    crosses a zone border changes pace at the border)."""
+    if words < 0:
+        raise ValueError("negative words")
+    zones = _scaled(get_profile(profile_name), total_s)
+    t, left = t_start_s, float(words)
+    for lo, hi, z in zones:
+        if t >= hi and z is not zones[-1][2]:
+            continue
+        wps = z["heard_wpm_target"] / 60.0
+        room = (hi - max(t, lo)) * wps
+        last = z is zones[-1][2]
+        if left <= room or last:
+            return t + left / wps - t_start_s
+        t, left = hi, left - room
+    return t - t_start_s
diff --git a/explainer_engine/finish/upscale.py b/explainer_engine/finish/upscale.py
new file mode 100644
index 0000000..0df59c5
--- /dev/null
+++ b/explainer_engine/finish/upscale.py
@@ -0,0 +1,53 @@
+"""WP-5b: an LTX clip (1920x1088, the sizes the video model takes: width and height divisible by 64, edit/clay_video.py)
+becomes a delivery-frame clip (BP-167, 2560x1440 at 24 fps): the 4 px strips the model's size adds are cropped off the top
+and bottom to a true 16:9 frame, then a Lanczos scale. ffmpeg only, free, deterministic. A latent upscaler on the pod is a
+different, paid step and is not this one. Shorts are not made here: ``production/shorts.py`` owns them (BP-167, 1440x2560)."""
+from __future__ import annotations
+
+import os
+import subprocess
+from pathlib import Path
+
+from explainer_engine.core import delivery
+from explainer_engine.core.errors import ConfigError
+
+CRF = 17  # the same crf as production/shorts.FINAL_VIDEO: the clip is re-encoded once more in assembly
+
+
+def video_filter(src_w: int, src_h: int, size: tuple[int, int] | None = None) -> str:
+    """The -vf chain: crop to the delivery aspect (centred, never stretch), then Lanczos to the delivery size at its fps."""
+    w, h = size or delivery.size()
+    if src_w <= 0 or src_h <= 0:
+        raise ConfigError(f"source size {src_w}x{src_h} is not a picture")
+    if src_w * h >= src_h * w:  # wider than the delivery aspect (or equal): trim the sides
+        crop_w, crop_h = round(src_h * w / h) // 2 * 2, src_h
+    else:  # taller (the model's 1088): trim the top and bottom
+        crop_w, crop_h = src_w, round(src_w * h / w) // 2 * 2
+    if crop_w < src_w * 0.9 or crop_h < src_h * 0.9:
+        raise ConfigError(f"{src_w}x{src_h} is not close to {w}:{h}: cropping would cut more than 10 %, re-render the clip")
+    return f"crop={crop_w}:{crop_h}:(in_w-out_w)/2:(in_h-out_h)/2,scale={w}:{h}:flags=lanczos,fps={delivery.fps()}"
+
+
+def probe_size(path: Path | str) -> tuple[int, int]:
+    out = subprocess.run(["ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries", "stream=width,height",
+                          "-of", "csv=p=0:s=x", str(path)], capture_output=True, text=True)
+    if out.returncode != 0 or "x" not in out.stdout:
+        raise ConfigError(f"ffprobe could not read {path}: {out.stderr.strip()[:200]}")
+    w, h = out.stdout.strip().split("x")[:2]
+    return int(w), int(h)
+
+
+def upscale(src: Path | str, dst: Path | str, size: tuple[int, int] | None = None) -> Path:
+    """``src`` to ``dst`` at the delivery frame. The sound track is dropped (a native-audio LTX clip keeps its own through the
+    sound stems); a temp file is renamed so a half-written clip never lies under the final name."""
+    w, h = probe_size(src)
+    dst = Path(dst)
+    part = dst.with_suffix(".part.mp4")
+    cmd = ["ffmpeg", "-v", "error", "-y", "-i", str(src), "-vf", video_filter(w, h, size), "-an", "-c:v", "libx264",
+           "-crf", str(CRF), "-preset", "medium", "-pix_fmt", "yuv420p", str(part)]
+    done = subprocess.run(cmd, capture_output=True, text=True)
+    if done.returncode != 0:
+        part.unlink(missing_ok=True)
+        raise ConfigError(f"upscale failed: {done.stderr.strip()[:300]}")
+    os.replace(part, dst)
+    return dst
diff --git a/explainer_engine/llm/build_loop.py b/explainer_engine/llm/build_loop.py
new file mode 100644
index 0000000..ff7c256
--- /dev/null
+++ b/explainer_engine/llm/build_loop.py
@@ -0,0 +1,176 @@
+"""Fable/Opus build loop for one work package (creator 2026-11-01, API line ``build_loop``; OR-35, OR-36).
+
+    python -m explainer_engine.llm.build_loop run <wp.json> [--no-check]
+
+The session orchestrates and reads only the printed summary (file names, test result, verdict lines, cost). A work package file::
+
+    {"id": "WP-1a", "goal": "...", "wp_text_file": "path to the WP's section", "inputs": ["repo paths passed verbatim"],
+     "files": ["repo paths the coder must write"], "tests": ["pytest args"], "check_question": "one line",
+     "coder_max_tokens": 64000, "fix_max_tokens": 48000, "check_max_tokens": 16000}
+
+Steps: coder (Opus, high) -> place files -> py_compile + tests -> check (Fable, high, short verdict) -> fix (Opus) up to twice.
+Every call goes through ``llm/claude_api.py`` (caps, ledger, streams saved), never directly. A truncated coder answer is
+continued per missing file only. Nothing here edits protected config.
+"""
+from __future__ import annotations
+
+import json
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+JOB = "build_loop"
+FILE_RE = re.compile(r"^=== FILE: (.+?) ===\n", re.M)
+RULES_CODER = (
+    "You are the coder (Opus, high). Implement the work package exactly; do not re-decide. Verify facts with the read-only tools "
+    "(list_dir, read_file, grep over the repo) or mark `# UNVERIFIED:`; never invent an API, flag, class or path. Match the repo "
+    "style (line length ~120, Python 3.12). Output ONLY file blocks: a line `=== FILE: <repo-relative path> ===` then the complete "
+    "file, no fences, no diffs. Write the files in the order given; if you cannot finish all, finish the current file fully and "
+    "end with a line `TRUNCATED_AFTER <path>`. Think briefly: the answer must arrive.")
+RULES_CHECK = (
+    "You are the checker (Fable, high). Judge the files against the work package. Output lines only: `PASS <file>` or "
+    "`FIX <file>:<line-or-symbol> - <one sentence>`, and the last line `VERDICT PASS` or `VERDICT FIX` or `VERDICT STOP` "
+    "(STOP = the coder took a money or goal decision that belongs to the creator). Think briefly; no other text.")
+
+
+def _run_job(work: Path, name: str, model: str, effort: str, max_tokens: int, system: dict, user: str, task_class: str) -> dict:
+    d = work / name
+    (d / "in").mkdir(parents=True, exist_ok=True)
+    (d / "out").mkdir(exist_ok=True)
+    names = []
+    for i, (title, text) in enumerate(t for t in system.items() if t[1].strip()):   # the API refuses an empty block
+        f = d / "in" / f"{i:02d}_{title}.txt"
+        f.write_text(text, encoding="utf-8")
+        names.append(f"in/{f.name}")
+    job = {"job": JOB, "task_class": task_class, "model": model, "effort": effort, "max_tokens": max_tokens, "cache_ttl": "5m",
+           "system_files": names, "requests": [{"id": name.upper().replace("-", "_"), "user": user}],
+           "tools_root": str(ROOT), "max_turns": 5}
+    (d / "job.json").write_text(json.dumps(job, indent=1), encoding="utf-8")
+    p = subprocess.run([sys.executable, "-m", "explainer_engine.llm.claude_api", "run", str(d / "job.json"), "--out", str(d / "out")],
+                       cwd=ROOT, capture_output=True, text=True)
+    (d / "run.log").write_text(p.stdout + p.stderr, encoding="utf-8")
+    out = sorted((d / "out").glob("*.md"))
+    text = ""
+    for f in out:
+        if not f.name.endswith(".thinking.md"):
+            text = f.read_text(encoding="utf-8")
+    cost = re.findall(r'"usd":\s*([0-9.]+)', p.stdout)
+    return {"text": text, "truncated": any(f.name.endswith(".truncated.md") for f in out), "rc": p.returncode,
+            "usd": sum(float(c) for c in cost), "dir": str(d)}
+
+
+def parse_files(text: str) -> dict[str, str]:
+    parts = FILE_RE.split(text)
+    files = {}
+    for i in range(1, len(parts), 2):
+        body = parts[i + 1]
+        body = re.sub(r"\nTRUNCATED_AFTER [^\n]*\n?\Z", "\n", body)
+        files[parts[i]] = body.rstrip("\n") + "\n"
+    return files
+
+
+def complete_files(text: str, truncated: bool) -> dict[str, str]:
+    """Files whose body is whole: all of them, except the last block of a truncated answer."""
+    parts = FILE_RE.split(text)
+    names = parts[1::2]
+    files = parse_files(text)
+    if (truncated or "TRUNCATED_AFTER" in text) and names:
+        files.pop(names[-1], None)
+    return files
+
+
+def place(files: dict[str, str], allowed: list[str]) -> list[str]:
+    placed = []
+    for rel, body in files.items():
+        if rel not in allowed:
+            continue                                                  # the coder may write only the package's files
+        p = ROOT / rel
+        p.parent.mkdir(parents=True, exist_ok=True)
+        p.write_text(body, encoding="utf-8")
+        placed.append(rel)
+    return placed
+
+
+def verify(files: list[str], tests: list[str]) -> tuple[bool, str]:
+    log = []
+    ok = True
+    for rel in files:
+        if rel.endswith(".py"):
+            r = subprocess.run([sys.executable, "-m", "py_compile", rel], cwd=ROOT, capture_output=True, text=True)
+            if r.returncode:
+                ok = False
+                log.append(f"py_compile {rel}: {r.stderr.strip()[-300:]}")
+    if tests:
+        r = subprocess.run([sys.executable, "-m", "pytest", "-q", "-x", "--no-header", *tests], cwd=ROOT, capture_output=True, text=True)
+        tail = "\n".join((r.stdout + r.stderr).strip().splitlines()[-25:])
+        log.append(tail)
+        ok = ok and r.returncode == 0
+    return ok, "\n".join(log)
+
+
+def read_inputs(paths: list[str]) -> dict[str, str]:
+    return {Path(p).name.replace(".", "_"): f"### {p}\n" + (ROOT / p).read_text(encoding="utf-8") for p in paths if (ROOT / p).exists()}
+
+
+def run(wp: dict, check: bool = True) -> dict:
+    work = ROOT / "jobs" / "build_loop" / wp["id"]
+    work.mkdir(parents=True, exist_ok=True)
+    wp_text = (ROOT / wp["wp_text_file"]).read_text(encoding="utf-8") if wp.get("wp_text_file") else wp.get("goal", "")
+    system = {"rules": RULES_CODER, "wp": wp_text, **read_inputs(wp.get("inputs", []))}
+    user = "Write these files, complete, in this order:\n" + "\n".join(f"- {f}" for f in wp["files"])
+    total, steps = 0.0, []
+    r = _run_job(work, "coder", "opus", "high", wp.get("coder_max_tokens", 64000), system, user, "new-method-code")
+    total += r["usd"]
+    text, truncated = r["text"], r["truncated"]
+    got = complete_files(text, truncated)
+    for _ in range(2):                                                # continue only the missing files
+        missing = [f for f in wp["files"] if f not in got]
+        if not missing:
+            break
+        c = _run_job(work, f"cont{len(steps)}", "opus", "high", wp.get("coder_max_tokens", 64000), system,
+                     "Write ONLY these files, complete, nothing else:\n" + "\n".join(f"- {f}" for f in missing), "new-method-code")
+        total += c["usd"]
+        got.update(complete_files(c["text"], c["truncated"]))
+        steps.append("continued: " + ", ".join(missing))
+    placed = place(got, wp["files"])
+    ok, log = verify(placed, wp.get("tests", []))
+    verdict = ["(check skipped)"]
+    for rnd in range(3):
+        if not check:
+            break
+        files_text = {Path(p).name.replace(".", "_"): f"### {p}\n" + (ROOT / p).read_text(encoding="utf-8") for p in placed}
+        k = _run_job(work, f"check{rnd}", "fable", "high", wp.get("check_max_tokens", 16000),
+                     {"rules": RULES_CHECK, "wp": wp_text, "test_output": log, **files_text},
+                     wp.get("check_question", "Does the code satisfy the work package?"), "research-synthesis")
+        total += k["usd"]
+        verdict = [ln for ln in k["text"].splitlines() if ln.startswith(("PASS", "FIX", "VERDICT"))]
+        last = verdict[-1] if verdict else "VERDICT FIX"
+        if last.endswith("PASS") and ok or last.endswith("STOP") or rnd == 2:
+            break
+        fixes = "\n".join(ln for ln in verdict if ln.startswith("FIX")) + ("\nTest output:\n" + log if not ok else "")
+        f = _run_job(work, f"fix{rnd}", "opus", "high", wp.get("fix_max_tokens", 48000),
+                     {"rules": RULES_CODER, "wp": wp_text, "fixes": fixes, **files_text},
+                     "Fix only what the FIX lines and the test output name. Write the changed files complete.", "new-method-code")
+        total += f["usd"]
+        place(complete_files(f["text"], f["truncated"]), wp["files"])
+        ok, log = verify(placed, wp.get("tests", []))
+        steps.append(f"fix round {rnd + 1}")
+    summary = {"id": wp["id"], "placed": placed, "missing": [f for f in wp["files"] if f not in placed], "tests_ok": ok,
+               "verdict": verdict, "steps": steps, "usd": round(total, 3)}
+    (work / "summary.json").write_text(json.dumps(summary, indent=1), encoding="utf-8")
+    return summary
+
+
+def main(argv: list[str]) -> int:
+    if len(argv) < 2 or argv[0] != "run":
+        print(__doc__)
+        return 2
+    wp = json.loads(Path(argv[1]).read_text(encoding="utf-8"))
+    print(json.dumps(run(wp, check="--no-check" not in argv), indent=1, ensure_ascii=False))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
