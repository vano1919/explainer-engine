          "type": [
            "boolean",
            "null"
          ]
        },
        "blocks_downstream": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "regeneration_required": {
                    "const": true
                  }
                },
                "required": [
                  "regeneration_required"
                ]
              },
              {
                "properties": {
                  "state": {
                    "const": "NO_PERCEPTION_INPUT"
                  }
                },
                "required": [
                  "state"
                ]
              },
              {
                "properties": {
                  "is_continuation": {
                    "const": true
                  },
                  "prior_shot_passed": {
                    "not": {
                      "const": true
                    }
                  }
                },
                "required": [
                  "is_continuation",
                  "prior_shot_passed"
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "blocks_downstream": {
                "const": true
