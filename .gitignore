__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
.idea/
.vscode/
node_modules/

# jobs, renders and temporary files (never commit media)
jobs/*
!jobs/.gitkeep
channel/
tmp/
*.tmp
*.tmp-*
*.mp4
*.wav
*.mp3
*.flac

# local models, binaries and keys (setup.ps1 downloads models; keys are created by hand)
tools/
*.onnx
*.onnx_data
*.gguf
assets/maps/relief/*.tif
assets/maps/relief/*.tfw
.env
*api_key*
*token*.json
*.pem
id_ed25519*

# per-session pointer for the ElevenLabs gate hook (explainer_engine/standards/hook.py)
.claude/active_episode.json

# resumable upload sessions of the YouTube staging step (publish/stage.py)
.sessions.json

# local Claude Code settings (may hold permissions or keys)
.claude/settings.local.json

# episode example media (photos and reads live on HF, see the example's README)
examples/episodes/*/media/
# sound library (LIB-06): originals and derived indexes stay out of git
assets/audio/originals/
assets/audio/library/catalog.sqlite
assets/audio/previews/

# local neural TTS weights, Natural Earth GeoJSONs, cached world relief, and vendor JS bundles
assets/models/kokoro/
assets/maps/ne_10m_geojson/
assets/maps/relief/paleo_mercator_world*.png
assets/design_system/vendor/
explainer_engine/maps/maplibre_lane/vendor/*.js
explainer_engine/maps/maplibre_lane/vendor/*.css

