{
  "_meta": {
    "workflow_id": "wan22_fun_control_v1",
    "stage": "stage3_video_control",
    "supported_modes": ["WAN_CONTROL"],
    "supported_modalities": ["openpose", "depth", "canny", "camera_preset", "trajectory_ati_experimental"],
    "description": "Parameterized local ComfyUI API workflow for selective Wan22FunControlToVideo with a single explicit control modality (D-123)."
  },
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "{{checkpoint_file}}",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "text_encoders/umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "type": "wan"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "vae/Wan2.2_VAE.safetensors"
    }
  },
  "4": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{start_image_path}}"
    }
  },
  "5": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{control_file_path}}"
    }
  },
  "6": {
    "class_type": "WanCameraEmbedding",
    "inputs": {
      "camera_pose": "{{control_modality}}",
      "width": "{{width}}",
      "height": "{{height}}",
      "length": "{{num_frames}}"
    }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["2", 0],
      "text": "{{motion_prompt}}"
    }
  },
  "8": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["2", 0],
      "text": "{{negative_prompt}}"
    }
  },
  "9": {
    "class_type": "Wan22FunControlToVideo",
    "inputs": {
      "positive": ["7", 0],
      "negative": ["8", 0],
      "vae": ["3", 0],
      "ref_image": ["4", 0],
      "control_video": ["5", 0],
      "camera_conditions": ["6", 0],
      "control_modality": "{{control_modality}}",
      "control_strength": "{{control_strength}}",
      "width": "{{width}}",
      "height": "{{height}}",
      "length": "{{num_frames}}",
      "batch_size": 1
    }
  },
  "10": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["1", 0],
      "positive": ["9", 0],
      "negative": ["9", 1],
      "latent_image": ["9", 2],
      "seed": "{{seed}}",
      "steps": "{{steps}}",
      "cfg": "{{cfg_scale}}",
      "sampler_name": "uni_pc",
      "scheduler": "simple",
      "denoise": 1.0
    }
  },
  "11": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["10", 0],
      "vae": ["3", 0]
    }
  },
  "12": {
    "class_type": "SaveVideo",
    "inputs": {
      "images": ["11", 0],
      "fps": "{{fps}}",
      "filename_prefix": "{{output_prefix}}"
    }
  }
}
