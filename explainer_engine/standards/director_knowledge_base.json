  "sound_staging_policy_c1": {
    "numeric_quotas_decide": false,
    "intentional_silence_allowed": true,
    "density_hint_severity": "REVIEW",
    "spatial_staging": "level, pan (2*x - 1), distance LPF, and camera-push gain (+0..2.5 dB) follow the visible source in the picture; narration sits on its own plane with presence-band (280-3600 Hz) carving."
  },
  "ltx_natural_fit_policy_c2": {
    "ltx_natural_for": [
      "wide silhouettes, landscape, snow, fog, fire, lantern glow, and atmosphere with slow camera moves",
      "single-character medium close-up (MCU), 3/4 painted face, closed mouth or restrained expression, one coherent soft light, 4-5 s",
      "people seen from behind, over-the-shoulder (OTS), or in silhouette",
      "approaches, walking, climbing, leaving trenches, and wide group compositions",
      "two-character visible handshake in wide/medium-wide framing (detail hands/buttons as 2.5D insert at pause)"
    ],
    "ltx_25d_or_detail_insert": [
      "tiny objects, letters, family photographs, buttons, rifles on sandbags (2.5D insert at motivated pause)",
      "complex multi-finger hand interactions (2.5D fallback where necessary, not a blanket ban on faces)",
      "identity-critical static portraits when no physical action occurs"
    ],
    "visible_singing_policy": {
      "owner_decision_date": "2026-11-16",
      "primary_combination": "Route C (2.5D audio-driven viseme mouth shapes M0-M5 over approved painted 3/4 face) + Route E (mixed cinematic coverage: eye CU, chest breath, hand on lantern/coat)",
      "optional_variation": "Route A (profile / 3/4 rear view with timed breath vapor and controlled jaw)",
      "experimental_fallback": "Route D (LatentSync 1.6 mouth/lower-face composite only; never replace full face; MuseTalk 1.5 secondary experiment)",
      "ltx_face_rule_elsewhere": "Retain semi-realistic painted 2.5D/LTX 3/4 MCU face rule (closed mouth, restrained motion, 4-5 s, one soft light) for all non-singing shots",
      "viseme_inventory": [
        "M0_closed_rest",
        "M1_slightly_open",
        "M2_medium_open",
        "M3_wide_open_vowel",
        "M4_rounded_vowel",
        "M5_narrow_teeth"
      ],
      "sustained_vowel_rule": "Drive visemes primarily by phoneme timing with audio energy and note duration as secondary controls; hold vowel shapes across sustained notes; never drive mouth openness by raw volume alone."
    },
    "continuity_modes": [
      "continuation",
      "coverage",
      "insert",
      "ltx_chain_tail",
      "ltx_chain_crop_ots",
      "ltx_scene_master_cov",
      "ltx_flf_bridge",
      "cutaway_insert_bridge",
      "new_anchor_reset"
    ]
  },
  "upscale_policy_c3": {
    "pluggable_per_lane": true,
    "lanes": {
      "still_25d": {
        "default_backend": "lanczos",
        "options": [
          "none",
          "lanczos",
          "realplksr4x",
          "span2x"
        ],
        "restore_painted_grain": true
      },
      "video": {
        "default_backend": "temporal_video",
        "options": [
          "none",
          "lanczos",
          "temporal_video"
        ],
        "restore_painted_grain": true
      }
    }
  }
}
