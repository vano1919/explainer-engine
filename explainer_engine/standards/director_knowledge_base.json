{
  "schema": "director_knowledge_base/2.0",
  "version": "2.1.0",
  "murch_decision_hierarchy": {
    "emotion": 0.51,
    "story": 0.23,
    "rhythm": 0.1,
    "eye_trace": 0.07,
    "planarity_2d": 0.05,
    "continuity_3d": 0.04,
    "rule": "Emotional truth (director_brief) and story focus outweigh mechanical geometry; never add decorative effects to satisfy a count."
  },
  "stillness_and_liveliness_policy": {
    "mandatory_effect_count": 0,
    "mandatory_family_count": 0,
    "deliberately_still_allowed": true,
    "require_written_reason_per_element": true,
    "outcomes": {
      "DELIBERATELY_STILL": "PASS when the director records a concrete stillness_reason or why per element serving the brief.",
      "ACCIDENTALLY_FROZEN": "FAIL when camera or living tracks were planned with non-zero strength but rendered frames show near-zero optical flow.",
      "TECHNICALLY_BROKEN": "FAIL when holder_leak_p95, forbidden_region_particle_leak, or anchor crop slicing exceeds calibrated safety bounds."
    }
  },
  "perception_and_reconciliation_policy": {
    "missed_detection_is_not_absence": true,
    "uncertainty_threshold": 0.6,
    "low_confidence_action": "REVIEW (needs_eye=true, conservative framing, never invent effects)",
    "authority_split": {
      "physical_objects_and_geometry": "perceive_picture(start_01.png) + layers/manifest.json",
      "story_meaning": "spoken audio_lines",
      "emotional_intent": "shot.director_brief",
      "story_breaking_conflict": "episodes/<ep>/production/regeneration_queue.json"
    }
  },
  "camera_feasibility_rules": {
    "push_in": {
      "changes_3d_angle": false,
      "max_scale_gain": 0.12,
      "require_all_kept_faces_inside_end_crop": true,
      "min_face_edge_clearance_pct": 0.04,
      "protect_foreground_anchor_bases": true
    },
    "pull_back": {
      "changes_3d_angle": false,
      "start_overscan": 1.15,
      "forbid_joint_cut_on_start_crop": [
        "neck",
        "chin",
        "eyes",
        "ankles"
      ]
    },
    "pan_crop_2d": {
      "changes_3d_angle": false,
      "overscan": 1.1,
      "max_shift_x_pct": 0.09,
      "safe_for_unlayered_crowds": true,
      "require_kept_span_x_max": 0.86
    },
    "crane_up": {
      "changes_3d_angle": false,
      "require_sky_open": true,
      "min_sky_area_pct": 12.0,
      "min_bottom_face_clearance_pct": 0.12
    },
    "truck_25d": {
      "changes_3d_angle": true,
      "min_edge_margin_x": 0.14,
      "min_depth_edge_alignment": 2.2,
      "max_hole_share": 0.06,
      "forbid_if_unlayered_crowd": true,
      "fallback_op": "pan_crop_2d"
    },
    "orbit_small": {
      "changes_3d_angle": true,
      "max_people_count": 1,
      "min_edge_margin_x": 0.22,
      "min_depth_edge_alignment": 2.8,
      "max_hole_share": 0.04,
      "forbid_if_unlayered_crowd": true,
      "forbid_if_thin_fg_objects": true,
      "fallback_op": "push_in"
    },
    "rack_focus": {
      "changes_3d_angle": false,
      "min_fg_bg_depth_delta": 0.28,
      "sigma_px": 5.5
    }
  },
  "variety_and_continuity_rules": {
    "no_two_same_camera_ops_in_a_row": true,
    "max_push_in_in_5_shot_window": 2,
    "window_size_non_map": 5,
    "max_push_share_non_map": 0.4,
    "max_same_weather_fx_combo_in_a_row": 2,
    "same_location_min_scale_step": 0.3,
    "max_eye_trace_focal_jump_on_hard_cut": 0.32,
    "map_to_map_same_theater_inherit_camera": true,
    "map_to_map_transition": "cross_dissolve_8f",
    "meaning_link_types": [
      "CAUSE",
      "CONSEQUENCE",
      "PARALLEL",
      "CONTRAST",
      "POV_TRANSFER",
      "OBJECT_MOTIF",
      "TIME_JUMP",
      "EPOCH_JUMP"
    ],
    "chorus_sequence_continuity": true,
    "allow_multi_location_chorus": true,
    "forbid_unmotivated_still_in_continuous_action": true,
    "time_place_epoch_jump_requires_meaning_link": true
  },
