{
  "schema": "send_scope/1",
  "note": "Which paths are trial or comparison outputs that a send hook guards, and which commands are uploads or trial runs (spec section 7.1). Scope by path so a log or a vault file passes. push_command: a push names no file, so every trial output with a known layer that git would send (or any, outside git) must have its passing record (S4).",
  "trial_path": "(^|/)(trials?|comparisons?|candidates?|ab_tests?|t_tests?)(/|_)|(^|/)[^/]*_(trial|comparison|candidate)s?[^/]*$",
  "layer_in_path": "(^|[/_.-])(L(?:[1-9]|[12][0-9]|3[0-3]))([/_.-]|$)",
  "upload_command": "(upload_file|upload_folder|upload_large_folder|upload-large-folder|\\bhf\\s+upload\\b|huggingface-cli\\s+upload|\\bcreate_commit\\b|\\bcurl\\b[^|;\\n]*\\s(-[a-zA-Z]*[TF]\\b|--upload-file|--form\\b|--data-binary\\s+@|--data-raw\\s+@|-d\\s+@)|\\bwget\\b[^|;\\n]*--post-file|\\bgsutil\\s+(-\\S+\\s+)*(cp|rsync|mv)\\b|\\b(scp|sftp|rsync|rclone)\\b|\\baws\\s+s3\\s+(cp|sync|mv)\\b|\\bgh\\s+(release\\s+upload|gist\\s+create)\\b|\\bgit\\s+(-\\S+\\s+)*(lfs\\s+)?push\\b|push_to_hub)",
  "trial_command": {
    "scene_run": [
      "L12",
      "L13"
    ],
    "episode_run": "stage"
  },
  "file_suffixes": [
    ".png",
    ".jpg",
    ".jpeg",
    ".webp",
    ".mp4",
    ".mov",
    ".webm",
    ".gif",
    ".wav",
    ".mp3",
    ".html",
    ".md",
    ".json",
    ".txt",
    ".zip"
  ],
  "push_command": "(\\bgit\\s+(-\\S+\\s+)*(lfs\\s+)?push\\b|push_to_hub)"
}
