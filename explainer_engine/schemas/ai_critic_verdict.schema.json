{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://explainer-engine.local/schemas/ai_critic_verdict.schema.json",
  "title": "AI Media Critic Verdict (ai_critic_verdict/1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "component",
    "video_path",
    "video_sha256",
    "duration_s",
    "inspected_utc",
    "inspector_role",
    "overall_score",
    "verdict",
    "audio_visual_sync_verified",
    "scores",
    "defects",
    "strengths",
    "remediation_actions"
  ],
  "properties": {
    "schema": {
      "const": "ai_critic_verdict/1"
    },
    "component": {
      "type": "string",
      "enum": [
        "bridges",
        "maps",
        "fx25d",
        "audio",
        "ltx_scene",
        "storyboard",
        "final_film",
        "youtube_ab_packaging"
      ]
    },
    "video_path": {
      "type": "string",
      "minLength": 1
    },
    "video_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "duration_s": {
      "type": "number",
      "minimum": 0.0
    },
    "inspected_utc": {
      "type": "string",
      "minLength": 10
    },
    "inspector_role": {
      "type": "string",
      "minLength": 3
    },
    "overall_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 10.0
    },
    "verdict": {
      "type": "string",
      "enum": ["APPROVE", "REJECT", "NEEDS_REMEDIATION"]
    },
    "audio_visual_sync_verified": {
      "type": "boolean"
    },
    "scores": {
      "type": "object",
      "minProperties": 4,
      "additionalProperties": {
        "type": "number",
        "minimum": 0.0,
        "maximum": 10.0
      }
    },
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["timecode", "severity", "category", "description", "recommended_fix"],
        "properties": {
          "timecode": {
            "type": "string",
            "pattern": "^[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(-[0-9]{2}:[0-9]{2}(\\.[0-9]+)?)?$"
          },
          "severity": {
            "type": "string",
            "enum": ["critical", "major", "minor"]
          },
          "category": {
            "type": "string",
            "minLength": 2
          },
          "description": {
            "type": "string",
            "minLength": 5
          },
          "recommended_fix": {
            "type": "string",
            "minLength": 5
          }
        }
      }
    },
    "strengths": {
      "type": "array",
      "items": { "type": "string", "minLength": 3 }
    },
    "remediation_actions": {
      "type": "array",
      "items": { "type": "string", "minLength": 3 }
    }
  }
}
