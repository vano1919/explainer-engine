     "type": "integer",
     "minimum": 1
    },
    "read_s": {
     "type": "number",
     "minimum": 0
    },
    "total_frames": {
     "type": "integer",
     "minimum": 1
    },
    "total_seconds": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "shots": {
     "type": "object",
     "minProperties": 1,
     "propertyNames": {
      "type": "string",
      "minLength": 1
     },
     "additionalProperties": {
      "$ref": "#/$defs/shot_v2"
     }
    },
    "spines": {
     "type": "object",
     "propertyNames": {
      "type": "string",
      "minLength": 1
     },
     "additionalProperties": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/spine_word"
      }
     }
    },
    "inserts": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/insert_item"
     }
    },
    "clip_timed": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "coverage": {
     "anyOf": [
      {
       "type": "number",
       "minimum": 0,
       "maximum": 1
      },
      {
       "type": "null"
      }
     ]
    },
    "alignment_status": {
     "anyOf": [
      {
       "type": "string",
       "minLength": 1
      },
      {
       "type": "null"
      }
     ]
    },
    "unmatched": {
     "type": "array"
    },
    "segments": {
     "type": "object",
     "minProperties": 1,
     "propertyNames": {
      "type": "string",
      "minLength": 1
     },
     "additionalProperties": {
      "type": "object",
      "properties": {
       "segment_id": {
        "type": "string",
        "minLength": 1
       },
       "start_frame": {
        "type": "integer",
        "minimum": 0
       },
       "end_frame": {
        "type": "integer",
        "minimum": 1
       },
       "frames": {
        "type": "integer",
        "minimum": 1
       },
       "start_s": {
        "type": "number",
        "minimum": 0
       },
       "end_s": {
        "type": "number",
        "exclusiveMinimum": 0
       }
      },
      "required": [
       "segment_id",
       "start_frame",
       "end_frame",
       "frames",
       "start_s",
       "end_s"
      ],
      "additionalProperties": false
     }
    },
    "narrator_offsets": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "properties": {
       "shot_id": {
        "type": "string",
        "minLength": 1
       },
       "segment_id": {
        "type": "string",
        "minLength": 1
       },
       "timeline_start_frame": {
        "type": "integer",
        "minimum": 0
       },
       "timeline_end_frame": {
        "type": "integer",
        "minimum": 1
       },
       "read_start_frame": {
        "type": "integer",
        "minimum": 0
       },
       "read_end_frame": {
        "type": "integer",
        "minimum": 0
       },
       "paused_for_insert": {
        "type": "boolean"
       }
      },
      "required": [
       "shot_id",
       "segment_id",
       "timeline_start_frame",
       "timeline_end_frame",
       "read_start_frame",
       "read_end_frame",
       "paused_for_insert"
      ],
      "additionalProperties": false
     }
    },
    "dialogue_positions": {
     "type": "object",
     "propertyNames": {
      "type": "string",
      "minLength": 1
     },
     "additionalProperties": {
      "type": "object",
      "properties": {
       "shot_id": {
        "type": "string",
        "minLength": 1
       },
       "segment_id": {
        "type": "string",
        "minLength": 1
       },
       "start_frame": {
        "type": "integer",
        "minimum": 0
       },
       "end_frame": {
        "type": "integer",
        "minimum": 1
       },
       "frames": {
        "type": "integer",
        "minimum": 1
       },
       "start_s": {
        "type": "number",
        "minimum": 0
       },
       "end_s": {
        "type": "number",
        "exclusiveMinimum": 0
       },
       "at_read_frame": {
        "type": "integer",
        "minimum": 0
       },
       "in_s": {
        "type": "number",
        "minimum": 0
       },
       "out_s": {
        "type": "number",
        "minimum": 0
       },
       "clip_path": {
        "type": "string",
        "minLength": 1
       }
      },
      "required": [
       "shot_id",
       "segment_id",
       "start_frame",
       "end_frame",
       "frames",
       "start_s",
       "end_s",
       "at_read_frame",
       "in_s",
       "out_s",
       "clip_path"
      ],
      "additionalProperties": false
     }
    },
    "map_events": {
     "type": "object",
     "propertyNames": {
      "type": "string",
      "minLength": 1
     },
     "additionalProperties": {
      "type": "object",
      "properties": {
       "shot_id": {
        "type": "string",
        "minLength": 1
       },
       "segment_id": {
        "type": "string",
        "minLength": 1
       },
       "start_frame": {
        "type": "integer",
        "minimum": 0
       },
       "end_frame": {
        "type": "integer",
        "minimum": 1
       },
       "frames": {
        "type": "integer",
        "minimum": 1
       },
       "start_s": {
        "type": "number",
        "minimum": 0
       },
       "end_s": {
        "type": "number",
