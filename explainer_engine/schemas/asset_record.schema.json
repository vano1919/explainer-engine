{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asset_record.schema.json",
  "title": "One generated picture, clip or take: the untouched original with its hash and provenance (plan §5.3, imagegen/vault.py); one JSON line of episodes/<ep>/assets/asset_records.jsonl",
  "type": "object",
  "required": ["schema", "asset_id", "episode_id", "shot_id", "type", "sha256", "version", "parent", "provider", "model",
               "prompt_hash", "references", "seed", "parameters", "cost", "created", "observation_record_id",
               "creator_approval"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "asset_record/1"},
    "asset_id": {"type": "string", "minLength": 3},
    "episode_id": {"type": "string", "minLength": 1},
    "shot_id": {"type": "string", "minLength": 1},
    "type": {"type": "string", "minLength": 1, "description": "image_start, image_end, master, clip_raw, clip, take, ..."},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "size": {"type": ["integer", "null"], "minimum": 0},
    "path": {"type": ["string", "null"], "description": "repo-relative path of the local original (assets/originals/...); null while the bytes exist only on the primary copy"},
    "hf_path": {"type": ["string", "null"], "description": "path of the same bytes on the primary Hugging Face dataset (config/vault.json primary)"},
    "version": {"type": "integer", "minimum": 1},
    "parent": {"type": ["string", "null"]},
    "provider": {"type": ["string", "null"]},
    "model": {"type": ["string", "null"]},
    "prompt_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "references": {"type": "array", "items": {"type": "string"}},
    "seed": {"type": ["integer", "string", "null"]},
    "parameters": {"type": "object"},
    "cost": {"type": ["number", "null"], "minimum": 0},
    "created": {"type": "string"},
    "observation_record_id": {"type": ["string", "null"]},
    "creator_approval": {"type": ["string", "null"]},
    "note": {"type": ["string", "null"]}
  },
  "anyOf": [{"required": ["path"], "properties": {"path": {"type": "string"}}},
            {"required": ["hf_path"], "properties": {"hf_path": {"type": "string"}}}]
}
