        "lens_mm": {
         "type": "number",
         "exclusiveMinimum": 0
        },
        "ease": {
         "enum": [
          "linear",
          "ease_in",
          "ease_out",
          "ease_in_out"
         ]
        }
       }
      },
      "light_rig": {
       "type": "string",
       "minLength": 1,
       "description": "a named light rig preset (ICW-05)"
      },
      "weather": {
       "anyOf": [
        {
         "type": "string",
         "minLength": 1
        },
        {
         "type": "null"
        }
       ]
      },
      "props": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/assetref"
       }
      }
     }
    },
    "performance": {
     "type": "object",
     "required": [
      "lipsync",
      "rhubarb",
      "mouth_shapes",
      "dialogue_cover"
     ],
     "additionalProperties": false,
     "properties": {
      "lipsync": {
       "type": "boolean"
      },
      "rhubarb": {
       "anyOf": [
        {
         "$ref": "#/$defs/fileref"
        },
        {
         "type": "null"
        }
       ],
       "description": "the Rhubarb mouth-cue JSON of the voiced line; only its sha256 enters the cache key"
      },
      "mouth_shapes": {
       "const": 8
      },
      "dialogue_cover": {
       "anyOf": [
        {
         "enum": [
          "on_screen",
          "off_screen"
         ]
        },
        {
         "type": "null"
        }
       ]
      }
     }
    },
    "look": {
     "type": "object",
     "required": [
      "bible_version",
      "crease_deg",
      "shading_steps",
      "view_transform",
      "grade_look",
      "paper",
      "shade_mode",
      "line_mode"
     ],
     "additionalProperties": false,
     "properties": {
      "bible_version": {
       "type": "string",
       "pattern": "^[0-9]+\\.[0-9]+$"
      },
      "line_weight_px": {
       "type": "number",
       "exclusiveMinimum": 0,
       "description": "Line Art weight at 1440p (BP-173)"
      },
      "crease_deg": {
       "type": "number",
       "minimum": 0,
       "maximum": 180
      },
      "shading_steps": {
       "type": "integer",
       "minimum": 1
      },
      "view_transform": {
       "enum": [
        "AgX",
        "Standard",
        "Khronos PBR Neutral"
       ]
      },
      "grade_look": {
       "type": "string",
       "minLength": 1,
       "description": "Blender's look name without the 'AgX - ' prefix; 'None' under Standard and Khronos PBR Neutral"
      },
      "paper": {
       "type": "object",
       "required": [
        "asset",
        "opacity"
       ],
       "additionalProperties": false,
       "properties": {
        "asset": {
         "$ref": "#/$defs/assetref"
        },
        "opacity": {
         "type": "number",
         "minimum": 0,
         "maximum": 1
        }
       }
      },
      "shade_mode": {
       "enum": [
        "toon",
        "soft",
        "feathered",
        "flat",
        "painted_light"
       ],
       "description": "style.SHADE_MODES; toon = the ICW-05 three-step graph"
      },
      "shade_path": {
       "enum": [
        "luma",
        "lit",
        "rgb_soft"
       ],
       "description": "style.SHADE_PATHS (the soft mode's node path)"
      },
      "line_mode": {
       "enum": [
        "none",
        "faint",
        "dark",
        "ink"
       ]
      }
     },
     "allOf": [
      {
       "if": {
        "properties": {
         "line_mode": {
          "enum": [
           "faint",
           "dark",
           "ink"
          ]
         }
        }
       },
       "then": {
        "required": [
         "line_weight_px"
        ]
       }
      },
      {
       "if": {
        "properties": {
         "line_mode": {
          "const": "none"
         }
        }
       },
       "then": {
        "not": {
         "required": [
          "line_weight_px"
         ]
        }
       }
      },
      {
       "if": {
        "properties": {
         "view_transform": {
          "const": "AgX"
         }
        }
       },
       "else": {
        "properties": {
         "grade_look": {
          "const": "None"
         }
        }
       }
      }
     ]
    },
    "render": {
     "type": "object",
     "required": [
      "profile",
      "samples",
      "motion_blur",
      "denoise",
      "output"
     ],
     "additionalProperties": false,
     "properties": {
      "profile": {
       "enum": [
        "eevee_fast",
        "eevee_full",
        "eevee_painterly",
        "cycles_hero"
       ]
      },
      "samples": {
       "type": "integer",
       "minimum": 1
      },
      "motion_blur": {
       "type": "boolean"
      },
      "denoise": {
       "type": "boolean"
      },
      "output": {
       "enum": [
        "mkv_ffv1",
        "png_seq"
       ]
      }
     }
    },
    "seed": {
     "type": "integer"
    },
    "why": {
     "type": "string",
     "minLength": 1,
     "description": "creator-readable justification; required on cycles_hero"
    },
    "episode_scope": {
     "type": "string",
     "minLength": 1
    },
    "historical_period": {
     "type": "string",
     "minLength": 1
    },
    "era_tags": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "geographic_tags": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "domain_tags": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "asset_selection_audit": {
     "type": "object",
     "properties": {
      "candidate_assets_considered": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "rejected_candidates": {
       "type": "array",
       "items": {
        "type": "object"
       }
      },
      "selected_asset_id": {
       "type": "string"
      },
      "selection_reason": {
       "type": "string"
      }
     }
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "render": {
        "properties": {
         "profile": {
          "const": "cycles_hero"
         }
        }
       }
      }
     },
     "then": {
      "required": [
       "why"
      ]
     }
    }
   ]
  }
 }
}
