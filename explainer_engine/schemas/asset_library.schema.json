{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asset_library.schema.json",
  "title": "Reusable asset library: one record per channel asset with provenance, licence, hash, lineage and approval (/1 raster and audio; /2 adds the 3D kinds, D-110)",
  "type": "object",
  "required": [
    "schema"
  ],
  "properties": {
    "schema": {
      "enum": [
        "asset_library/1",
        "asset_library/2"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema": {
            "const": "asset_library/1"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/v1"
      }
    },
    {
      "if": {
        "properties": {
          "schema": {
            "const": "asset_library/2"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/v2"
      }
    }
  ],
  "$defs": {
    "v1": {
      "type": "object",
      "required": [
        "schema",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "asset_library/1"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "file",
              "sha256",
              "bytes",
              "tags",
              "description",
              "bible_version",
              "made_with",
              "licence",
              "approval",
              "lineage",
              "origin"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z]+\\.[a-z0-9_]+(\\.[a-z0-9_]+)?$",
                "description": "<kind>.<name>[.<variant>] (P-66)"
              },
              "kind": {
                "enum": [
                  "reference",
                  "anchor",
                  "sheet",
                  "sprite",
                  "picture",
                  "plate",
                  "prop",
                  "collage",
                  "lora",
                  "prompt",
                  "sound",
                  "music",
                  "font"
                ]
              },
              "file": {
                "type": "string",
                "minLength": 1,
                "description": "path relative to the repository root"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              },
              "tags": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]+$"
                }
              },
              "description": {
                "type": "string"
              },
              "bible_version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+$",
                "description": "the World Bible version the asset was made under"
              },
              "made_with": {
                "type": "object",
                "required": [
                  "provider",
                  "model",
                  "model_version",
                  "prompt",
                  "params",
                  "seed",
                  "refs",
                  "lora",
                  "cost_usd"
                ],
                "additionalProperties": false,
                "properties": {
                  "provider": {
                    "type": "string",
                    "description": "gemini, bfl, fal, pod, local, elevenlabs, drawn, procedural, third_party or empty"
                  },
                  "model": {
                    "type": "string"
                  },
                  "model_version": {
                    "type": "string"
                  },
                  "prompt": {
                    "type": "string"
                  },
                  "params": {
                    "type": "object"
                  },
                  "seed": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "asset ids given as references"
                  },
                  "unresolved_refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "reference files that were not library assets"
                  },
                  "lora": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "asset id of the LoRA used"
                  },
                  "cost_usd": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              },
              "licence": {
                "type": "object",
                "required": [
                  "status",
                  "note"
                ],
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "enum": [
                      "own_drawn",
                      "own_procedural",
                      "generated_terms_unverified",
                      "generated_terms_verified",
                      "licensed",
                      "ofl",
                      "cc0"
                    ]
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "approval": {
                "type": "object",
                "required": [
                  "status",
                  "by",
                  "at",
                  "note"
                ],
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "enum": [
                      "not_looked",
                      "approved",
                      "rejected",
                      "superseded"
                    ]
                  },
                  "by": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "at": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "note": {
                    "type": "string"
                  }
                }
              },
              "lineage": {
                "type": "object",
                "required": [
                  "parent"
                ],
                "additionalProperties": false,
                "properties": {
                  "parent": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "the asset this one was derived from"
                  }
                }
              },
              "origin": {
                "type": "object",
                "required": [
                  "episode",
                  "created",
                  "source"
                ],
                "additionalProperties": false,
                "properties": {
                  "episode": {
                    "type": "string",
                    "description": "the episode whose budget paid for it; empty for channel work"
                  },
                  "created": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string",
                    "description": "where the record came from: a paint plan id, a ledger line, sound_library:<id>, picture_library:<id>"
                  }
                }
              }
            }
          }
        }
      },
      "description": "asset_library/1: raster, audio, font and LoRA records (the library before D-110)"
    },
    "v2": {
      "type": "object",
      "required": [
        "schema",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "asset_library/2"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "file",
              "sha256",
              "bytes",
              "tags",
              "description",
              "bible_version",
              "made_with",
              "licence",
              "approval",
              "lineage",
              "origin",
              "deps",
              "storage"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z_]+\\.[a-z0-9_]+(\\.[a-z0-9_]+)?$",
                "description": "<kind>.<name>[.<variant>] (P-66); the kind may hold an underscore (blend_collection, scene_template)"
              },
              "kind": {
                "enum": [
                  "reference",
                  "anchor",
                  "sheet",
                  "sprite",
                  "picture",
                  "plate",
                  "prop",
                  "collage",
                  "lora",
                  "prompt",
                  "sound",
                  "music",
                  "font",
                  "model",
                  "rig",
                  "animation",
                  "material",
                  "texture",
                  "hdri",
                  "blend_collection",
                  "scene_template",
                  "costume"
                ]
              },
              "file": {
                "type": "string",
                "minLength": 1,
                "description": "path relative to the repository root"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              },
              "tags": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]+$"
                }
              },
              "description": {
                "type": "string"
              },
              "bible_version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+$",
                "description": "the World Bible version the asset was made under"
              },
              "made_with": {
                "type": "object",
                "required": [
                  "provider",
                  "model",
                  "model_version",
                  "prompt",
                  "params",
                  "seed",
                  "refs",
                  "lora",
                  "cost_usd"
                ],
                "additionalProperties": false,
                "properties": {
                  "provider": {
                    "type": "string",
                    "description": "gemini, bfl, fal, pod, local, elevenlabs, drawn, procedural, third_party or empty"
                  },
                  "model": {
                    "type": "string"
                  },
                  "model_version": {
                    "type": "string"
                  },
                  "prompt": {
                    "type": "string"
                  },
                  "params": {
                    "type": "object"
                  },
                  "seed": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "asset ids given as references"
                  },
                  "unresolved_refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "reference files that were not library assets"
                  },
                  "lora": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "asset id of the LoRA used"
                  },
                  "cost_usd": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              },
              "licence": {
                "type": "object",
                "required": [
                  "status",
                  "note",
                  "commercial_use"
                ],
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "enum": [
                      "own_drawn",
                      "own_procedural",
                      "generated_terms_unverified",
                      "generated_terms_verified",
                      "licensed",
                      "ofl",
                      "cc0",
                      "cc-by-4.0",
                      "mit-tool",
                      "gpl-tool-only",
                      "vendor-terms",
                      "community-licence-revenue-capped",
                      "restricted-territory"
                    ]
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_url": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "revision_or_version": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "inspected_on": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "redistribution": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "derivatives": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "attribution": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "geo_or_revenue_limits": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "weights_vs_code_note": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "outputs_note": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "commercial_use": {
                    "enum": [
                      "yes",
                      "no",
                      "unknown"
                    ],
                    "description": "unknown blocks approval (21.4, docs/ASSET_SYSTEM.md)"
                  }
                }
              },
              "approval": {
                "type": "object",
                "required": [
                  "status",
                  "by",
                  "at",
                  "note"
                ],
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "enum": [
                      "not_looked",
                      "approved",
                      "rejected",
                      "superseded"
                    ]
                  },
                  "by": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "at": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "note": {
                    "type": "string"
                  }
                }
              },
              "lineage": {
                "type": "object",
                "required": [
                  "parent"
                ],
                "additionalProperties": false,
                "properties": {
                  "parent": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "the asset this one was derived from"
                  }
                }
              },
              "origin": {
                "type": "object",
                "required": [
                  "episode",
                  "created",
                  "source"
                ],
                "additionalProperties": false,
                "properties": {
                  "episode": {
                    "type": "string",
                    "description": "the episode whose budget paid for it; empty for channel work"
                  },
                  "created": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string",
                    "description": "where the record came from: a paint plan id, a ledger line, sound_library:<id>, picture_library:<id>"
                  }
                }
              },
              "deps": {
                "type": "array",
                "description": "every file a .blend or model links, by asset id and sha256 (21.5 #6)",
                "items": {
                  "type": "object",
                  "required": [
                    "asset_id",
                    "sha256"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "asset_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
                }
              },
              "storage": {
                "type": "object",
                "required": [
                  "location",
                  "external_path"
                ],
                "additionalProperties": false,
                "description": "binaries over 5 MB live outside git (D-110): external_path is the vault (HF) path",
                "properties": {
                  "location": {
                    "enum": [
                      "git",
                      "external"
                    ]
                  },
                  "external_path": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              "three_d": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "format",
                  "skeleton_id",
                  "rig_profile",
                  "compatible_animation_sets",
                  "poly_count",
                  "bounds_m",
                  "units",
                  "up_axis",
                  "materials"
                ],
                "properties": {
                  "format": {
                    "enum": [
                      "glb",
                      "gltf",
                      "fbx",
                      "blend",
                      "obj",
                      "exr",
                      "hdr",
                      "png",
                      "jpg"
                    ]
                  },
                  "skeleton_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^skeleton\\.[a-z0-9_]+$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "rig_profile": {
                    "anyOf": [
                      {
                        "enum": [
                          "ubc_humanoid",
                          "rigify",
                          "mixamo",
                          "mpfb2"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "compatible_animation_sets": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "poly_count": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "bounds_m": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "number",
                          "minimum": 0
                        },
                        "minItems": 3,
                        "maxItems": 3
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "units": {
                    "const": "m"
                  },
                  "up_axis": {
                    "enum": [
                      "Y",
                      "Z"
                    ]
                  },
                  "materials": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "retargeted_from": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "enum": [
                        "model",
                        "rig",
                        "animation",
                        "costume",
                        "scene_template",
                        "blend_collection"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "three_d"
                  ]
                }
              }
            ]
          }
        }
      },
      "description": "asset_library/2 (D-110, roadmap 9.3 and 21.4-21.5): /1 plus the 3D kinds, a three_d block, deps, storage and the licence record"
    }
  }
}
