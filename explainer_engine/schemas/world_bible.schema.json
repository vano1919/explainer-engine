{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "world_bible.schema.json",
  "title": "World Bible (schema version 1): the channel's visual world under one version, with the creator's approval",
  "type": "object",
  "required": ["schema", "version", "status", "date", "reason", "approved_by", "approved_at", "parts", "camera_language",
               "graphics_style", "era_change_rules", "characters", "motion", "banned_drift", "anchors", "changelog"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "world_bible/1"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "approved", "superseded"]},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "reason": {"type": "string", "minLength": 1, "description": "why this version exists"},
    "approved_by": {"type": ["string", "null"]},
    "approved_at": {"type": ["string", "null"]},
    "parts": {
      "type": "object",
      "description": "the files the bible versions: the look thread, the era codex, the palette; pinned by hash",
      "required": ["look", "eras", "palette"],
      "additionalProperties": false,
      "properties": {
        "look": {"$ref": "#/$defs/part"},
        "eras": {"$ref": "#/$defs/part"},
        "palette": {"$ref": "#/$defs/part"}
      }
    },
    "camera_language": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "graphics_style": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "era_change_rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "characters": {
      "type": "object",
      "required": ["permanent", "note"],
      "additionalProperties": false,
      "properties": {
        "permanent": {"type": "boolean", "description": "whether characters carry over between episodes"},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "motion": {
      "type": "object",
      "required": ["default", "generated_video"],
      "additionalProperties": false,
      "properties": {
        "default": {"type": "string", "minLength": 1},
        "generated_video": {"type": "string", "minLength": 1}
      }
    },
    "banned_drift": {"type": "array", "items": {"type": "string", "minLength": 1},
                     "description": "what a new version may never bring back (the look's child cues and banned words live in the look part)"},
    "anchors": {"type": "array", "items": {"type": "string", "pattern": "^[a-z]+\\.[a-z0-9_]+(\\.[a-z0-9_]+)?$"},
                "description": "asset library ids of the approved reference pictures that define this version's look"},
    "changelog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["version", "date", "reason", "approved_by"],
        "additionalProperties": false,
        "properties": {
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
          "date": {"type": "string"},
          "reason": {"type": "string", "minLength": 1},
          "approved_by": {"type": ["string", "null"]},
          "note": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "part": {
      "type": "object",
      "required": ["file", "sha256"],
      "additionalProperties": false,
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
