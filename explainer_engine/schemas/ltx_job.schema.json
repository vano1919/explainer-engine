{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ltx_job/1",
  "title": "ltx_job/1: the LTX generations of the J2 and J4 shots (D-116), one row per clip x base x variant x seed",
  "description": "Written by edit/ltx_jobs.py from the route shots and the layout manifests, read by the route-test pod (training/pods/p14). Paths are vault paths (HF); a sha256 of null is an input the pod makes first (the Qwen first frame) or one not uploaded yet. Rules LJ-01..LJ-07 (docs/LTX_JOBS.md).",
  "type": "object",
  "required": ["schema", "job_id", "episode", "code", "jobs"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "ltx_job/1"},
    "job_id": {"type": "string", "minLength": 1},
    "episode": {"type": "string", "minLength": 1},
    "code": {"type": "object", "required": ["url", "sha"], "additionalProperties": false,
             "properties": {"url": {"type": "string"}, "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}},
    "derived_from": {"type": "object"},
    "jobs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "shot_id", "clip_id", "route", "recipe", "base", "model", "lora", "frames", "fps", "width", "height",
                     "seed", "first_frame", "conditioning", "prompt", "stage2_ic", "output"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "shot_id": {"type": "string", "minLength": 1},
          "clip_id": {"type": "string", "minLength": 1},
          "route": {"enum": ["J2", "J4"]},
          "recipe": {"enum": ["ltx_layout/1", "ltx_restyle/1"]},
          "base": {"enum": ["ltx25", "ltx23"]},
          "variant": {"type": "string"},
          "model": {"type": "object", "required": ["key", "id", "revision", "sha256"], "additionalProperties": false,
                    "properties": {"key": {"type": "string"}, "id": {"type": "string"}, "revision": {"type": ["string", "null"]},
                                   "sha256": {"type": ["string", "null"]}}},
          "text_encoder": {"type": ["object", "null"], "required": ["key", "id", "revision", "sha256"], "additionalProperties": false,
                           "properties": {"key": {"type": "string"}, "id": {"type": "string"}, "revision": {"type": ["string", "null"]},
                                          "sha256": {"type": ["string", "null"]}}},
          "lora": {"type": "object", "required": ["key", "id", "revision", "file", "sha256", "strength"], "additionalProperties": false,
                   "properties": {"key": {"type": "string"}, "id": {"type": "string"}, "revision": {"type": ["string", "null"]},
                                  "file": {"type": "string"}, "sha256": {"type": ["string", "null"]},
                                  "strength": {"type": "number", "exclusiveMinimum": 0, "maximum": 2}}},
          "frames": {"type": "integer", "minimum": 1},
          "fps": {"type": "integer", "minimum": 1},
          "width": {"type": "integer", "minimum": 32},
          "height": {"type": "integer", "minimum": 32},
          "seed": {"type": "integer", "minimum": 0},
          "first_frame": {"type": "object", "required": ["path", "sha256", "pose", "prompt"], "additionalProperties": false,
                          "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": ["string", "null"]},
                                         "pose": {"const": "start"}, "prompt": {"type": "string"}}},
          "conditioning": {"type": "array", "minItems": 1,
                           "items": {"type": "object", "required": ["pass", "path", "sha256", "strength"], "additionalProperties": false,
                                     "properties": {"pass": {"enum": ["clay", "colour", "depth", "line", "canny_full"]},
                                                    "path": {"type": "string", "minLength": 1}, "sha256": {"type": ["string", "null"]},
                                                    "strength": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
                                                    "derive": {"enum": ["invert", "canny"]}}}},
          "attention_mask": {"type": ["object", "null"], "required": ["path", "sha256", "strength"], "additionalProperties": false,
                             "properties": {"path": {"type": "string"}, "sha256": {"type": ["string", "null"]},
                                            "strength": {"type": "number", "minimum": 0, "maximum": 1}}},
          "chain_from": {"type": ["object", "null"], "required": ["job", "frames"], "additionalProperties": false,
                         "properties": {"job": {"type": "string"}, "frames": {"type": "integer", "minimum": 1}}},
          "prompt": {"type": "string", "minLength": 1},
          "stage2_ic": {"type": "boolean"},
          "output": {"type": "string", "pattern": "\\.mp4$"}
        }
      }
    }
  }
}
