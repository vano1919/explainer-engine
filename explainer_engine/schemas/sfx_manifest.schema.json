{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sfx_manifest.schema.json",
  "title": "Reusable sound library manifest (version 1)",
  "type": "object",
  "required": ["version", "items"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "file", "category", "tags", "seconds", "sample_rate", "sha256", "peak_dbfs", "rms_dbfs",
                     "source", "licence", "review"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+__v[0-9]+$"},
          "file": {"type": "string", "pattern": "^[a-z]+/[a-z0-9_]+__v[0-9]+\\.wav$"},
          "category": {"enum": ["vocal", "foley", "music"]},
          "tags": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}},
          "seconds": {"type": "number", "exclusiveMinimum": 0},
          "kind": {"enum": ["one_shot", "loop"], "description": "BP-58: sfx_library.kind_of reads it before the loop flag"},
          "loop": {"type": "boolean",
                   "description": "true: made to tile seamlessly (beds, music loops); false: a one-shot that plays once. Missing means true (older manifests); assemble.Sounds.loopable reads it and a one-shot is never tiled."},
          "intended_seconds": {"type": "number", "exclusiveMinimum": 0,
                               "description": "the length the sound was prompted for; a stored length far from it (reveal_sting: asked ~4 s, stored 30.772 s) is caught at review, not in the mix"},
          "motif_of": {"type": "string", "minLength": 1, "description": "music only: the owner (faction, hero or the channel) whose motif this is (BP-123, SD-11)"},
          "beat_grid": {
            "type": "object",
            "required": ["bpm", "offset_s", "source"],
            "additionalProperties": false,
            "description": "music only: the beat grid action cuts are judged against (BP-123, SD-10)",
            "properties": {
              "bpm": {"type": "number", "exclusiveMinimum": 0},
              "offset_s": {"type": "number", "minimum": 0},
              "source": {"enum": ["declared", "measured"]}
            }
          },
          "sample_rate": {"type": "integer", "minimum": 8000},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "peak_dbfs": {"type": "number", "maximum": 0},
          "rms_dbfs": {"type": "number", "maximum": 0},
          "source": {
            "type": "object",
            "required": ["kind"],
            "additionalProperties": false,
            "properties": {
              "kind": {"enum": ["procedural", "gemini_tts", "lyria", "elevenlabs", "recorded", "third_party", "open_model"],
                       "description": "open_model: a take from a free generator, allowed only with source.admission (BP-162, SD-13)"},
              "model": {"type": "string"},
              "prompt": {"type": "string"},
              "seed": {"type": "integer"},
              "generated": {"type": "string"},
              "cost_usd_estimate": {"type": "number", "minimum": 0},
              "cost_credits": {"type": "number", "minimum": 0, "description": "ElevenLabs credits charged for this take (D-52)"},
              "generation_id": {"type": "string", "minLength": 1, "description": "the provider's generation id, to re-download or prove the take"},
              "admission": {"type": "string", "minLength": 1, "description": "open_model only: the id of the admission record in assets/audio/generator_admission.json (BP-162)"}
            }
          },
          "licence": {
            "type": "object",
            "required": ["status", "note"],
            "additionalProperties": false,
            "properties": {
              "status": {"enum": ["own_procedural", "generated_terms_unverified", "generated_terms_verified", "licensed", "cc0"]},
              "note": {"type": "string", "minLength": 1},
              "attribution": {"type": "string", "minLength": 1,
                              "description": "the credit line a CC BY (or similar) licence asks for; published in the description (D-83: text only, never a block)"}
            }
          },
          "review": {
            "type": "object",
            "required": ["machine", "human"],
            "additionalProperties": false,
            "properties": {
              "machine": {"type": "string"},
              "human": {"enum": ["not_listened", "approved", "rejected"]}
            }
          }
        }
      }
    }
  }
}
