{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shot_state.schema.json",
  "title": "Per-shot state machine bound to asset hashes (plan §5.1, episode/shot_state.py); episodes/<ep>/production/shot_state.json",
  "type": "object",
  "required": ["schema", "episode_id", "shots"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "shot_state/1"},
    "episode_id": {"type": "string"},
    "shots": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["state", "history", "retries", "assets"],
        "additionalProperties": false,
        "properties": {
          "state": {"enum": ["PLANNED", "VOICE_READY", "IMAGE_GENERATED", "IMAGE_OBSERVED", "IMAGE_RETRY", "IMAGE_ACCEPTED",
                             "VIDEO_GENERATED", "VIDEO_OBSERVED", "VIDEO_RETRY", "FALLBACK_25D", "CLIP_ACCEPTED", "SCENE_QA",
                             "CREATOR_APPROVAL", "READY_FOR_ASSEMBLY"]},
          "history": {"type": "array", "items": {
            "type": "object", "required": ["state", "sha256", "path", "at"], "additionalProperties": false,
            "properties": {"state": {"type": "string"}, "sha256": {"type": ["string", "null"]},
                           "path": {"type": ["string", "null"]}, "at": {"type": "string"}}}},
          "retries": {"type": "object", "required": ["image", "video"], "additionalProperties": false,
                      "properties": {"image": {"type": "integer", "minimum": 0, "maximum": 2},
                                     "video": {"type": "integer", "minimum": 0, "maximum": 2}}},
          "assets": {"type": "object", "additionalProperties": {
            "type": "object", "required": ["sha256", "path"], "additionalProperties": false,
            "properties": {"sha256": {"type": "string"}, "path": {"type": "string"}, "at": {"type": "string"}}}},
          "assembled": {"type": ["object", "null"]},
          "resets": {"type": "array", "items": {"type": "object"}}
        }
      }
    }
  }
}
