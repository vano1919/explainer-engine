{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blender_scene_manifest.schema.json",
  "title": "Blender scene manifest: what the bpy script built for one shot_spec/2 (roadmap 10.1; written by blender/scene_builder.py, ICW-06)",
  "type": "object",
  "required": [
    "schema",
    "job_id",
    "shot_id",
    "spec",
    "cache_key",
    "blender_version",
    "objects",
    "assets",
    "bounds",
    "camera_path",
    "import_settings"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "blender_scene_manifest/1"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "shot_id": {
      "type": "string",
      "minLength": 1
    },
    "spec": {
      "$ref": "#/$defs/fileref"
    },
    "cache_key": {
      "$ref": "#/$defs/sha256"
    },
    "blender_version": {
      "type": "string",
      "minLength": 1
    },
    "objects": {
      "type": "object",
      "required": [
        "total",
        "meshes",
        "armatures",
        "lights",
        "cameras"
      ],
      "additionalProperties": false,
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "meshes": {
          "type": "integer",
          "minimum": 0
        },
        "armatures": {
          "type": "integer",
          "minimum": 0
        },
        "lights": {
          "type": "integer",
          "minimum": 0
        },
        "cameras": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "sha256",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "bounds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "object",
          "min",
          "max"
        ],
        "additionalProperties": false,
        "properties": {
          "object": {
            "type": "string",
            "minLength": 1
          },
          "min": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "max": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          }
        }
      }
    },
    "camera_path": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "frame",
          "pos",
          "yaw_deg",
          "pitch_deg"
        ],
        "additionalProperties": false,
        "properties": {
          "frame": {
            "type": "integer",
            "minimum": 0
          },
          "pos": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "yaw_deg": {
            "type": "number"
          },
          "pitch_deg": {
            "type": "number"
          }
        }
      }
    },
    "import_settings": {
      "type": "object",
      "description": "the fixed import settings per file format (21.5 #8)",
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fileref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "time": {
      "type": "string",
      "minLength": 10
    }
  }
}
