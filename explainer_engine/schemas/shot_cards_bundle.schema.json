{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shot_cards_bundle/1",
  "title": "A set of shot cards for one slice of an episode (W8): continuity_card/1 documents plus the clock they were timed from",
  "type": "object",
  "required": [
    "schema",
    "episode_id",
    "slice",
    "clock_source",
    "cards",
    "shot_order"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "shot_cards_bundle/1"
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "slice": {
      "type": "string",
      "minLength": 1
    },
    "clock_source": {
      "type": "string",
      "minLength": 5
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "schema"
        ],
        "properties": {
          "schema": {
            "enum": [
              "continuity_card/1",
              "continuity_card/2"
            ]
          }
        }
      }
    },
    "shot_order": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "the slice's shots in story order"
    }
  }
}