# xworld_v2 (D-80): one LoRA on Qwen-Image-2.1, the new world's look under `xworld style` + the show's sequence pairs under
# `rm style` (ვანო 2026-10-26 13:26 Tbilisi, the round plan). Settings as xworld_v1 (rank 16, lr 1e-4, 1024 px); trained in
# rounds of 750 steps: xworld_v2.sh sets train.steps to 750, 1500, 2250, 3000 and reruns, ai-toolkit resumes from the last
# save. @SAMPLES@ is filled by xworld_v2_build.py.
job: extension
config:
  name: "xworld_v2"
  process:
    - type: 'diffusion_trainer'
      training_folder: "/workspace/output"
      device: cuda:0
      # no trigger_word: each caption file starts with its own trigger (xworld style / rm style; LT-13)
      network:
        type: "lora"
        linear: 16
        linear_alpha: 16
      save:
        dtype: float16
        save_every: 750
        max_step_saves_to_keep: 12
      datasets:
        - folder_path: "/workspace/ds/new"
          caption_ext: "txt"
          caption_dropout_rate: 0.0
          num_repeats: 3   # xworld_v2_build.NEW_REPEATS
          cache_latents_to_disk: true
          resolution: [1024]
        - folder_path: "/workspace/ds/pairs/target"
          control_path: ["/workspace/ds/pairs/control"]
          caption_ext: "txt"
          caption_dropout_rate: 0.0
          num_repeats: 1
          cache_latents_to_disk: true
          resolution: [1024]
      train:
        batch_size: 1
        cache_text_embeddings: true
        steps: 750   # set per round by xworld_v2.sh
        gradient_accumulation: 1
        timestep_type: "weighted"
        content_or_style: "balanced"
        train_unet: true
        train_text_encoder: false
        gradient_checkpointing: true
        noise_scheduler: "flowmatch"
        optimizer: "adamw8bit"
        lr: 1e-4
        dtype: bf16
      model:
        name_or_path: "Qwen/Qwen-Image-2.1"
        arch: "qwen_image_2"
        quantize: true
        qtype: "qfloat8"
        quantize_te: true
        qtype_te: "qfloat8"
      sample:
        sampler: "flowmatch"
        sample_every: 750
        skip_first_sample: true   # the base model is measured by the round-0 test; a resume would sample again
        width: 1024
        height: 576
        samples: "@SAMPLES@"
        neg: ""
        seed: 42
        walk_seed: false
        guidance_scale: 4
        sample_steps: 30
meta:
  name: "xworld_v2"
  version: '2.0'
