  "font": "'Cinzel', 'Plus Jakarta Sans', Georgia, serif",
  "map": {
    "background": "#0B1622",
    "water": "#0B1622",
    "waterway": {"color": "#4E8BB0", "width": 1.3},
    "landcover": {"color": "#242D36", "opacity": 0.78},
    "boundary": {"color": "#6C97B5", "width": 1.2, "dash": [4, 2]},
    "roads": {"color": "#3E4A56", "width": 0.9},
    "hillshade": {"exaggeration": 0.65, "shadow": "#091018", "highlight": "#8FA6B8"}
  },
  "line": {
    "stroke": "#E39B43",
    "stroke_width": 3.4,
    "casing": "#1C2A38",
