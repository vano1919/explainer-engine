    "chip_bg": "#0B131E",
    "chip_fg": "#E39B43",
    "dot": "#FFF7E6",
    "dot_border": "#E39B43",
    "town_bg": "rgba(7,11,18,0.92)",
    "town_border": "rgba(232,240,248,0.32)",
    "town_text": "#F7F9FC",
    "footnote_text": "#DCE6F2",
    "footnote_bg": "rgba(7,12,19,0.86)"
