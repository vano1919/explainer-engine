  "finish": {
    "grain": {"opacity": 0.06, "size": 300},
    "vignette": 0.34,
    "tint": {"color": "#0A1726", "opacity": 0.08}
  },
  "palette_check": {
    "foreground": ["line.stroke", "hud.counter_value"],
